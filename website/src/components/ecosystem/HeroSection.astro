---
import releases from '../../data/releases.json';

const { kfit, web } = releases;
---

<div class="hero-block">
  <div class="hero-badge">
    <span class="badge-dot"></span>
    <span class="badge-text">Independent Indian Health Ecosystem</span>
  </div>

  <h1 class="hero-title">
    Fitness tracking that stays out of your way.
  </h1>

  <p class="hero-subtitle">
    Log Indian meals in plain language. Track workouts, body composition, hydration and trends locally on your device. Create an account only when you want cross-device sync.
  </p>

  <div class="hero-actions">
    <a
      href={kfit.apkUrl}
      class="btn btn-primary hero-btn-dl"
      id="heroDlBtn"
      data-kfit-dl
      title={`Download KFit APK (${kfit.version}, ${kfit.sizeFormatted})`}
    >
      <svg class="dl-arrow-icon" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
      </svg>
      <span class="btn-text">Download KFit for Android</span>
    </a>
    <a href={web.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost hero-btn-web">
      <span>Open KFit Web</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M10 14L21 3"/>
      </svg>
    </a>
  </div>

  <div class="hero-trust-bar">
    <span>No subscription</span>
    <span class="trust-sep">&bull;</span>
    <span>Works offline</span>
    <span class="trust-sep">&bull;</span>
    <span>Account optional</span>
  </div>
</div>

<style>
  .hero-block {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    padding-top: 36px;
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--card-glass);
    border: 1px solid var(--border);
    margin-bottom: 24px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-heading);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #30D158;
    box-shadow: 0 0 8px rgba(48, 209, 88, 0.6);
  }

  .hero-title {
    font-size: clamp(38px, 6.2vw, 68px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 20px;
    color: var(--text-heading);
  }

  .hero-subtitle {
    font-size: clamp(16.5px, 2.2vw, 20px);
    line-height: 1.5;
    color: var(--muted);
    max-width: 680px;
    margin: 0 auto 32px auto;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .hero-btn-dl {
    padding: 13px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .hero-btn-web {
    padding: 13px 26px;
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero-trust-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted2);
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .trust-sep {
    color: var(--border-hi);
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .hero-btn-dl, .hero-btn-web {
      width: 100%;
      justify-content: center;
    }
  }
</style>
