---
import fixturesData from '../../data/marketing_fixtures.json';

const fixtures = fixturesData.fixtures;
const initial = fixtures[0];
---

<section class="section interactive-demo" id="journal">
  <div class="section-heading">
    <span class="section-label">Interactive Preview</span>
    <h2 class="section-title">Natural Indian meal logging.</h2>
    <p class="section-subtitle">
      Type food naturally in everyday terms. KFit resolves authentic local dishes and portion sizes directly on your device.
    </p>
  </div>

  <div class="demo-card">
    <div class="demo-header">
      <div class="demo-dot-wrap">
        <span class="demo-dot red"></span>
        <span class="demo-dot yellow"></span>
        <span class="demo-dot green"></span>
      </div>
      <div class="demo-title">KFit Food Engine &middot; Example Interaction</div>
      <div class="demo-tag">Illustrative sample values</div>
    </div>

    <!-- Meal Samples Pill Bar -->
    <div class="meal-samples-container">
      <span class="samples-title">Try an example meal:</span>
      <div class="meal-samples-grid" role="group" aria-label="Example meals">
        <button type="button" class="meal-sample-btn active" data-meal="dosa" aria-pressed="true">
          <span>South Indian Breakfast</span>
        </button>
        <button type="button" class="meal-sample-btn" data-meal="lunch" aria-pressed="false">
          <span>High-Protein Lunch</span>
        </button>
        <button type="button" class="meal-sample-btn" data-meal="workout" aria-pressed="false">
          <span>Post-Workout Shake</span>
        </button>
        <button type="button" class="meal-sample-btn" data-meal="snack" aria-pressed="false">
          <span>Afternoon Snack</span>
        </button>
      </div>
    </div>

    <div class="demo-input-wrap">
      <label for="interactiveNoteInput" class="input-label">Natural Meal Description</label>
      <div class="input-container">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="text"
          id="interactiveNoteInput"
          class="interactive-input"
          value={initial.input}
          aria-label="Meal note input"
        />
      </div>
    </div>

    <!-- Dynamic Nutrient Output Cards -->
    <div class="nutrients-grid">
      <div class="nutrient-card highlight-card">
        <div class="n-val font-mono" id="demoCalories">{initial.calories}</div>
        <div class="n-label">Energy (kcal)</div>
      </div>
      <div class="nutrient-card">
        <div class="n-val font-mono" id="demoProtein">{initial.protein}g</div>
        <div class="n-label">Protein</div>
      </div>
      <div class="nutrient-card">
        <div class="n-val font-mono" id="demoCarbs">{initial.carbs}g</div>
        <div class="n-label">Carbohydrates</div>
      </div>
      <div class="nutrient-card">
        <div class="n-val font-mono" id="demoFats">{initial.fat}g</div>
        <div class="n-label">Fats</div>
      </div>
    </div>

    <div class="demo-meta-footer">
      <div class="meta-source" id="demoSourceText">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span id="demoSourceLabel">{initial.source}</span>
      </div>
      <span class="meta-badge">Verified Preset</span>
    </div>
  </div>

  <!-- Food Database Truth Section -->
  <div class="provenance-grid">
    <div class="prov-card">
      <div class="prov-tag">Local Primary</div>
      <h3>Curated KFit foods</h3>
      <p>848 hand-written food rows, mostly Indian dishes, using familiar serving units like katori, pieces, and bowls.</p>
    </div>
    <div class="prov-card">
      <div class="prov-tag">Lab Measured</div>
      <h3>IFCT 2017</h3>
      <p>528 lab-measured Indian food entries from ICMR-NIN with composition values stored per 100 g.</p>
    </div>
    <div class="prov-card">
      <div class="prov-tag">Optional Fallback</div>
      <h3>Packaged databases</h3>
      <p>OpenFoodFacts and USDA fallbacks for packaged barcode lookups when network access is enabled.</p>
    </div>
  </div>
</section>

<script>
  import fixturesData from '../../data/marketing_fixtures.json';

  const fixturesMap: Record<string, typeof fixturesData.fixtures[0]> = {};
  for (const f of fixturesData.fixtures) {
    fixturesMap[f.fixtureId] = f;
  }

  const noteInput = document.getElementById('interactiveNoteInput') as HTMLInputElement | null;
  const demoCal = document.getElementById('demoCalories');
  const demoPro = document.getElementById('demoProtein');
  const demoCarb = document.getElementById('demoCarbs');
  const demoFat = document.getElementById('demoFats');
  const demoSourceLabel = document.getElementById('demoSourceLabel');
  const mealBtns = document.querySelectorAll('.meal-sample-btn');

  function setFixture(f: typeof fixturesData.fixtures[0]) {
    if (noteInput) noteInput.value = f.input;
    if (demoCal) demoCal.textContent = f.calories.toString();
    if (demoPro) demoPro.textContent = `${f.protein}g`;
    if (demoCarb) demoCarb.textContent = `${f.carbs}g`;
    if (demoFat) demoFat.textContent = `${f.fat}g`;
    if (demoSourceLabel) demoSourceLabel.textContent = f.source;
  }

  function setCustomState() {
    if (demoCal) demoCal.textContent = '—';
    if (demoPro) demoPro.textContent = '—';
    if (demoCarb) demoCarb.textContent = '—';
    if (demoFat) demoFat.textContent = '—';
    if (demoSourceLabel) {
      demoSourceLabel.textContent = 'Custom meal description · Open KFit to resolve live';
    }
  }

  mealBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      mealBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      const mealKey = btn.getAttribute('data-meal');
      if (mealKey && fixturesMap[mealKey]) {
        setFixture(fixturesMap[mealKey]);
      }
    });
  });

  // When user edits text: check if it exactly matches any preset; otherwise clear stale macros
  noteInput?.addEventListener('input', () => {
    const val = noteInput.value.trim().toLowerCase();
    if (!val) {
      setCustomState();
      mealBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      return;
    }

    const matchedKey = Object.keys(fixturesMap).find((k) =>
      fixturesMap[k].input.toLowerCase() === val
    );

    if (matchedKey) {
      setFixture(fixturesMap[matchedKey]);
      mealBtns.forEach((b) => {
        const isMatch = b.getAttribute('data-meal') === matchedKey;
        b.classList.toggle('active', isMatch);
        b.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
      });
    } else {
      setCustomState();
      mealBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
    }
  });
</script>

<style>
  .interactive-demo {
    position: relative;
    z-index: 2;
  }

  .demo-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 28px;
    box-shadow: var(--card-shadow);
    max-width: 900px;
    margin: 0 auto;
    transition: all 0.3s ease;
  }

  .demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
    gap: 12px;
  }

  .demo-dot-wrap {
    display: flex;
    gap: 6px;
  }

  .demo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .demo-dot.red { background: #FF5F56; }
  .demo-dot.yellow { background: #FFBD2E; }
  .demo-dot.green { background: #27C93F; }

  .demo-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: -0.01em;
  }

  .demo-tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--muted2);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .meal-samples-container {
    margin-bottom: 22px;
  }

  .samples-title {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .meal-samples-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meal-sample-btn {
    padding: 7px 14px;
    border-radius: var(--radius-full);
    background: var(--card-2);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font);
  }

  .meal-sample-btn:hover {
    color: var(--text-heading);
    border-color: var(--border-hi);
  }

  .meal-sample-btn.active {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border-color: transparent;
    font-weight: 600;
  }

  .demo-input-wrap {
    margin-bottom: 24px;
  }

  .input-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .input-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    color: var(--muted);
    pointer-events: none;
  }

  .interactive-input {
    width: 100%;
    padding: 14px 16px 14px 44px;
    font-size: 15px;
    background: var(--card-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-heading);
    font-family: var(--font);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .interactive-input:focus {
    border-color: var(--apple-blue);
  }

  .nutrients-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .nutrient-card {
    background: var(--card-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .highlight-card {
    border-color: var(--border-hi);
  }

  .n-val {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-heading);
  }

  .n-label {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
  }

  .demo-meta-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
    gap: 12px;
    flex-wrap: wrap;
  }

  .meta-source {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .meta-badge {
    font-size: 10.5px;
    font-weight: 600;
    color: #30D158;
    background: rgba(48, 209, 88, 0.1);
    border: 1px solid rgba(48, 209, 88, 0.25);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .provenance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    max-width: 900px;
    margin: 32px auto 0 auto;
  }

  .prov-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prov-tag {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--apple-blue);
    width: fit-content;
  }

  .prov-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-heading);
  }

  .prov-card p {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 680px) {
    .nutrients-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .demo-card {
      padding: 18px;
    }
    .demo-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
