---
import releases from '../data/releases.json';

const kfitRelease = releases.kfit;
---

<nav class="nav" id="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="KFit Home">
      <div class="logo-mark">K</div>
      <span class="logo-text">KFit<span class="logo-badge">Ecosystem</span></span>
    </a>

    <!-- Clean, focused desktop navigation -->
    <div class="nav-links">
      <a href="/#products">Products</a>
      <a href="/#synergy">How It Works</a>
      <a href="/#sideload">Install</a>
      <a href="/#about">About</a>
    </div>

    <div class="nav-actions">
      <!-- Apple Light / Dark Theme Switcher with min 44px touch target -->
      <button
        class="theme-toggle-btn"
        id="themeToggleBtn"
        aria-label="Switch to light mode"
        title="Switch to light mode"
        type="button"
      >
        <span class="theme-toggle-inner">
          <span class="icon-sun">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </span>
          <span class="icon-moon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </span>
        </span>
      </button>

      <a href="https://getkfit.app" target="_blank" rel="noopener noreferrer" class="nav-link-web" title="Open Web App">
        <span>Web App</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M10 14L21 3"/>
        </svg>
      </a>

      <!-- Direct APK Download CTA — no erroneous download attribute -->
      <a
        href={kfitRelease.apkUrl}
        class="btn btn-primary nav-cta"
        id="navDlBtn"
        data-kfit-dl
        title={`Download KFit APK (${kfitRelease.version})`}
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
        </svg>
        <span class="nav-cta-text">Download KFit</span>
      </a>

      <!-- Apple Mobile Hamburger Menu Button (44px touch target) -->
      <button
        class="mobile-menu-btn"
        id="mobileMenuBtn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
        type="button"
      >
        <span class="menu-bar bar-1"></span>
        <span class="menu-bar bar-2"></span>
      </button>
    </div>
  </div>

  <!-- Apple Frosted Glass Mobile Drawer with accessible navigation & focus trap -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <nav class="container drawer-inner" aria-label="Mobile navigation">
      <div class="drawer-links">
        <a href="/#products" class="drawer-link">
          <span>Products</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#journal" class="drawer-link">
          <span>Food Journal</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#synergy" class="drawer-link">
          <span>How It Connects</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#principles" class="drawer-link">
          <span>Principles</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#sideload" class="drawer-link">
          <span>Install Guide</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#about" class="drawer-link">
          <span>About KFit</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </div>

      <div class="drawer-actions">
        <a href="https://getkfit.app" target="_blank" rel="noopener noreferrer" class="btn btn-ghost drawer-btn">
          <span>Launch Web App (getkfit.app)</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M10 14L21 3"/></svg>
        </a>
        <a
          href={kfitRelease.apkUrl}
          class="btn btn-primary drawer-btn"
          id="drawerNavDlBtn"
          data-kfit-dl
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
          </svg>
          <span class="drawer-dl-text">Download KFit APK ({kfitRelease.version})</span>
        </a>
      </div>
    </nav>
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Accessible Apple Theme Toggle
  const toggleBtn = document.getElementById('themeToggleBtn');
  
  const updateToggleAria = (currentTheme: string) => {
    if (!toggleBtn) return;
    const nextAction = currentTheme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
    toggleBtn.setAttribute('aria-label', nextAction);
    toggleBtn.setAttribute('title', nextAction);
  };

  // Sync initial label
  const initialTheme = document.documentElement.getAttribute('data-theme') || 'dark';
  updateToggleAria(initialTheme);

  toggleBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    updateToggleAria(next);
    try {
      localStorage.setItem('kfit-theme', next);
      const meta = document.getElementById('themeColorMeta');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#000000' : '#F5F5F7');
    } catch (e) {}
  });

  // Download feedback
  const bindDlFeedback = (id: string) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('click', () => {
      const textSpan = el.querySelector('.nav-cta-text, .drawer-dl-text, span');
      if (textSpan) {
        const prev = textSpan.textContent;
        textSpan.textContent = 'Starting Download…';
        setTimeout(() => { textSpan.textContent = prev; }, 3000);
      }
    });
  };
  bindDlFeedback('navDlBtn');
  bindDlFeedback('drawerNavDlBtn');

  // Mobile Drawer with Full Accessible Dialog Behavior & Focus Trap
  const menuBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  const drawerLinks = document.querySelectorAll('.drawer-link, .drawer-btn');

  const closeDrawer = () => {
    if (!menuBtn?.classList.contains('open')) return;
    menuBtn.classList.remove('open');
    drawer?.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'Open navigation menu');
    drawer?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    menuBtn.focus();
  };

  const openDrawer = () => {
    menuBtn?.classList.add('open');
    drawer?.classList.add('open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    menuBtn?.setAttribute('aria-label', 'Close navigation menu');
    drawer?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    
    // Focus first interactive element inside drawer
    const firstFocusable = drawer?.querySelector('a, button') as HTMLElement | null;
    firstFocusable?.focus();
  };

  const toggleDrawer = () => {
    const isOpen = menuBtn?.classList.contains('open');
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  };

  menuBtn?.addEventListener('click', toggleDrawer);

  drawerLinks.forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  // Focus trap inside mobile drawer
  drawer?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = drawer.querySelectorAll<HTMLElement>('a, button');
    if (!focusable || focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        last.focus();
        e.preventDefault();
      }
    } else {
      if (document.activeElement === last) {
        first.focus();
        e.preventDefault();
      }
    }
  });

  // Escape key to close & focus restoration
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.classList.contains('open')) {
      closeDrawer();
    }
  });

  // Outside click handling
  document.addEventListener('click', (e) => {
    if (menuBtn?.classList.contains('open') && drawer && !drawer.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
      closeDrawer();
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--nav-bg);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .nav.scrolled {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--text-heading);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.025em;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: var(--text-heading);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.04em;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .logo-badge {
    margin-left: 6px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.5px 7px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.18s ease;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: var(--text-heading);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* 44px min hit target on Theme Switcher */
  .theme-toggle-btn {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: opacity 0.2s ease;
  }

  .theme-toggle-inner {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--theme-toggle-bg);
    border: 1px solid var(--theme-toggle-border);
    color: var(--theme-toggle-color);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .theme-toggle-btn:hover .theme-toggle-inner {
    background: var(--border-hi);
  }

  .icon-sun, .icon-moon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  html[data-theme="light"] .icon-sun {
    display: none;
  }
  html[data-theme="light"] .icon-moon {
    display: flex;
  }
  html[data-theme="dark"] .icon-sun {
    display: flex;
  }
  html[data-theme="dark"] .icon-moon {
    display: none;
  }

  .nav-link-web {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .nav-link-web:hover {
    color: var(--text-heading);
    background: var(--btn-ghost-bg);
  }

  .nav-cta {
    padding: 7px 15px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    gap: 6px;
    border-radius: var(--radius-full);
  }

  /* Hamburger Menu Button */
  .mobile-menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    padding: 0;
    color: var(--text-heading);
  }

  .menu-bar {
    width: 18px;
    height: 1.5px;
    background: var(--text-heading);
    border-radius: 1px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .mobile-menu-btn.open .bar-1 {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-menu-btn.open .bar-2 {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile Drawer Overlay */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--nav-bg);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 199;
  }

  .mobile-drawer.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .drawer-inner {
    padding: 24px 20px 32px 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-heading);
    text-decoration: none;
    border-radius: 10px;
    transition: background-color 0.15s ease;
  }

  .drawer-link:hover, .drawer-link:active {
    background: var(--btn-ghost-bg);
  }

  .drawer-link svg {
    color: var(--muted);
  }

  .drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .drawer-btn {
    width: 100%;
    padding: 13px 20px;
    font-size: 14.5px;
    font-weight: 600;
    justify-content: center;
  }

  /* Responsive breakpoints: switch at 1024px to prevent tablet overcrowding */
  @media (max-width: 1024px) {
    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }
    .mobile-drawer { display: block; }
  }

  @media (max-width: 600px) {
    .nav-link-web { display: none; }
    .logo-badge { display: none; }
    .nav-cta-text { display: none; }
    .nav-cta {
      padding: 8px 12px;
    }
  }
</style>
