---
import releases from '../data/releases.json';

const kfitRelease = releases.kfit;
const kfitDlUrl = `/downloads/kfit`;
---

<nav class="nav" id="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="KFit Home">
      <div class="logo-mark">K</div>
      <span class="logo-text">KFit<span class="logo-badge">Ecosystem</span></span>
    </a>

    <div class="nav-links">
      <a href="/#journal">Food Journal</a>
      <a href="/#products">Products</a>
      <a href="/#synergy">How it Connects</a>
      <a href="/#principles">Principles</a>
      <a href="/#sideload">Install</a>
      <a href="/#about">About</a>
    </div>

    <div class="nav-actions">
      <!-- Apple Light / Dark Theme Switcher with min 44px touch target -->
      <button
        class="theme-toggle-btn"
        id="themeToggleBtn"
        aria-label="Switch to light mode"
        title="Switch to light mode"
        type="button"
      >
        <span class="theme-toggle-inner">
          <span class="icon-sun">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </span>
          <span class="icon-moon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </span>
        </span>
      </button>

      <a href="https://getkfit.app" target="_blank" rel="noopener noreferrer" class="nav-link-web" title="Open Web App">
        <span>Web App</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M10 14L21 3"/>
        </svg>
      </a>

      <!-- Stable Download URL consuming single source of truth -->
      <a href={kfitDlUrl} class="btn btn-primary nav-cta" download="kfit.apk" title={`Download KFit APK (${kfitRelease.version})`}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
        </svg>
        <span class="nav-cta-text">Download KFit</span>
      </a>

      <!-- Apple Mobile Hamburger Menu Button (44px touch target) -->
      <button
        class="mobile-menu-btn"
        id="mobileMenuBtn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
        type="button"
      >
        <span class="menu-bar bar-1"></span>
        <span class="menu-bar bar-2"></span>
      </button>
    </div>
  </div>

  <!-- Apple Frosted Glass Mobile Drawer with accessible modal interaction -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="container drawer-inner">
      <div class="drawer-links" role="menu">
        <a href="/#journal" class="drawer-link" role="menuitem">
          <span>Food Journal</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#products" class="drawer-link" role="menuitem">
          <span>Products</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#synergy" class="drawer-link" role="menuitem">
          <span>How it Connects</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#principles" class="drawer-link" role="menuitem">
          <span>Principles</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#sideload" class="drawer-link" role="menuitem">
          <span>Install Guide</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/#about" class="drawer-link" role="menuitem">
          <span>About KFit</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </div>

      <div class="drawer-actions">
        <a href="https://getkfit.app" target="_blank" rel="noopener noreferrer" class="btn btn-ghost drawer-btn">
          <span>Launch Web App (getkfit.app)</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
        </a>
        <a href={kfitDlUrl} class="btn btn-primary drawer-btn" download="kfit.apk">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
          </svg>
          <span>Download KFit APK ({kfitRelease.version})</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Accessible Apple Theme Toggle
  const toggleBtn = document.getElementById('themeToggleBtn');
  
  const updateToggleAria = (currentTheme: string) => {
    if (!toggleBtn) return;
    const nextAction = currentTheme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
    toggleBtn.setAttribute('aria-label', nextAction);
    toggleBtn.setAttribute('title', nextAction);
  };

  // Sync initial label
  const initialTheme = document.documentElement.getAttribute('data-theme') || 'dark';
  updateToggleAria(initialTheme);

  toggleBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    updateToggleAria(next);
    try {
      localStorage.setItem('kfit-theme', next);
      const meta = document.getElementById('themeColorMeta');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#000000' : '#F5F5F7');
    } catch (e) {}
  });

  // Mobile Drawer with Full Accessible Dialog Behavior
  const menuBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  const drawerLinks = document.querySelectorAll('.drawer-link, .drawer-btn');

  const closeDrawer = () => {
    if (!menuBtn?.classList.contains('open')) return;
    menuBtn.classList.remove('open');
    drawer?.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'Open navigation menu');
    drawer?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    menuBtn.focus();
  };

  const openDrawer = () => {
    menuBtn?.classList.add('open');
    drawer?.classList.add('open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    menuBtn?.setAttribute('aria-label', 'Close navigation menu');
    drawer?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    
    // Focus first link in drawer
    const firstFocusable = drawer?.querySelector('a') as HTMLElement | null;
    firstFocusable?.focus();
  };

  const toggleDrawer = () => {
    const isOpen = menuBtn?.classList.contains('open');
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  };

  menuBtn?.addEventListener('click', toggleDrawer);

  drawerLinks.forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  // Escape key to close & focus restoration
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.classList.contains('open')) {
      closeDrawer();
    }
  });

  // Outside click handling
  document.addEventListener('click', (e) => {
    if (menuBtn?.classList.contains('open') && drawer && !drawer.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
      closeDrawer();
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 14px 0;
    transition: padding 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }

  .nav.scrolled {
    background: var(--nav-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 4px 20px rgba(0, 0, 0, 0.08);
    padding: 10px 0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-heading);
    flex-shrink: 0;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    background: var(--icon-bg);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    color: var(--icon-text);
    letter-spacing: -0.5px;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .logo-text {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-heading);
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.25s ease;
  }

  .logo-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 100px;
    background: var(--border-hi);
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text-heading);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Apple Theme Toggle Button: 44px touch area, 34px visual */
  .theme-toggle-btn {
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .theme-toggle-inner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--theme-toggle-bg);
    border: 1px solid var(--theme-toggle-border);
    color: var(--theme-toggle-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
  }

  .theme-toggle-btn:hover .theme-toggle-inner {
    transform: scale(1.08);
  }

  .theme-toggle-btn:active .theme-toggle-inner {
    transform: scale(0.92);
  }

  .icon-sun, .icon-moon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :root:not([data-theme="light"]) .icon-moon { display: none; }
  :root:not([data-theme="light"]) .icon-sun { display: flex; }
  html[data-theme="light"] .icon-sun { display: none; }
  html[data-theme="light"] .icon-moon { display: flex; }

  .nav-link-web {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .nav-link-web:hover {
    color: var(--text-heading);
    background: var(--btn-ghost-bg);
  }

  .nav-cta {
    padding: 8px 16px;
    font-size: 13.5px;
    font-weight: 600;
    flex-shrink: 0;
  }

  /* Mobile Hamburger Menu Button: 44px touch region */
  .mobile-menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--theme-toggle-bg);
    border: 1px solid var(--theme-toggle-border);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu-btn:hover {
    transform: scale(1.06);
  }

  .menu-bar {
    width: 16px;
    height: 1.5px;
    background: var(--text-heading);
    border-radius: 1px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .mobile-menu-btn.open .bar-1 {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-menu-btn.open .bar-2 {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile Drawer Overlay */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--nav-bg);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 199;
  }

  .mobile-drawer.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .drawer-inner {
    padding: 24px 20px 32px 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-heading);
    text-decoration: none;
    border-radius: 10px;
    transition: background-color 0.15s ease;
  }

  .drawer-link:hover, .drawer-link:active {
    background: var(--btn-ghost-bg);
  }

  .drawer-link svg {
    color: var(--muted);
  }

  .drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .drawer-btn {
    width: 100%;
    padding: 13px 20px;
    font-size: 14.5px;
    font-weight: 600;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }
    .mobile-drawer { display: block; }
  }

  @media (max-width: 600px) {
    .nav-link-web { display: none; }
    .logo-badge { display: none; }
    .nav-cta-text { display: none; }
    .nav-cta {
      padding: 8px 12px;
    }
  }
</style>
