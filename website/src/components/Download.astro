---
// Public release URLs with dynamic client-side upgrade
const KFIT_APK_URL = 'https://github.com/Karthik77-kk/kfit/releases/latest/download/kfit.apk';
const JARVIS_APK_URL = 'https://github.com/Karthik77-kk/kfit/releases/latest/download/jarvis.apk';
const KFIT_RELEASES_URL = 'https://github.com/Karthik77-kk/kfit/releases';
const KFIT_WEB_URL = 'https://getkfit.app';
const GYMWORLD_URL = 'https://gymworld.getkfit.app';

interface Props {
  isStandalone?: boolean;
}

const { isStandalone = false } = Astro.props;
---

<section class={`section download-section ${isStandalone ? 'standalone-hub' : ''}`} id="download">
  <!-- Dynamic ambient glows -->
  <div class="dl-glow dl-glow-emerald" aria-hidden="true"></div>
  <div class="dl-glow dl-glow-cyan" aria-hidden="true"></div>
  <div class="dl-glow dl-glow-violet" aria-hidden="true"></div>

  <div class="container">
    <!-- ── Header Section ──────────────────────────────────────────────────────── -->
    <div class="hub-header">
      <div class="hub-tag-badge">
        <span class="pulse-indicator"></span>
        <span>The KFit Ecosystem &middot; Official Downloads &amp; Access</span>
      </div>

      <h2 class="hub-title">
        Built for performance.<br />
        <span class="gradient-text">Uncompromisingly private.</span>
      </h2>

      <p class="hub-subtitle">
        Four synchronized tools engineered for athletes, coaches, and everyone who takes their body seriously.
        Zero subscriptions. Zero third-party cloud trackers. Free forever.
      </p>

      <!-- Apple-style Segmented Control Filter -->
      <div class="segmented-control" role="tablist" aria-label="Product filter">
        <div class="seg-pill-bg" id="segPillBg" aria-hidden="true"></div>
        <button class="seg-btn active" data-filter="all" role="tab" aria-selected="true">
          <span class="seg-icon">✦</span>
          <span>All Products</span>
          <span class="seg-count">4</span>
        </button>
        <button class="seg-btn" data-filter="kfit-app" role="tab" aria-selected="false">
          <span class="seg-dot dot-green"></span>
          <span>KFit App</span>
        </button>
        <button class="seg-btn" data-filter="kfit-web" role="tab" aria-selected="false">
          <span class="seg-dot dot-cyan"></span>
          <span>KFit Web</span>
        </button>
        <button class="seg-btn" data-filter="gymworld" role="tab" aria-selected="false">
          <span class="seg-dot dot-orange"></span>
          <span>GymWorld</span>
        </button>
        <button class="seg-btn" data-filter="jarvis" role="tab" aria-selected="false">
          <span class="seg-dot dot-purple"></span>
          <span>JARVIS</span>
        </button>
      </div>
    </div>

    <!-- ── Product Grid: Apple Bento Architecture ─────────────────────────────── -->
    <div class="products-grid" id="productsGrid">

      <!-- ================= PRODUCT 1: KFIT APP ================= -->
      <article class="product-card card-kfit" data-category="kfit-app">
        <div class="card-spotlight" aria-hidden="true"></div>
        <div class="card-ambient-light light-green" aria-hidden="true"></div>

        <div class="product-card-top">
          <div class="brand-row">
            <div class="app-icon icon-kfit">
              <span class="icon-letter">K</span>
            </div>
            <div class="brand-meta">
              <div class="product-category">Native Android &middot; Offline-First</div>
              <h3 class="product-name">KFit App</h3>
            </div>
          </div>
          <div class="release-pill pill-green" id="kfitTagPill">
            <span class="mini-live-dot"></span>
            <span id="kfitVersionText">Latest APK</span>
          </div>
        </div>

        <p class="product-desc">
          Pure fitness tracking engineered for Indian diets.
          700+ verified IFCT dishes, smart body recomp analytics, MET-based workout burn, and 100% offline SQLite storage. Zero subscriptions. Zero tracking.
        </p>

        <!-- Interactive In-Card Mockup -->
        <div class="card-mockup-frame">
          <div class="mockup-header">
            <span class="mock-dot red"></span>
            <span class="mock-dot yellow"></span>
            <span class="mock-dot green"></span>
            <span class="mock-title">kfit-app &middot; verified ifct-2017</span>
            <span class="mock-badge-live">OFFLINE &middot; LOCAL SQLITE</span>
          </div>
          <div class="mockup-body mockup-kfit-body">
            <div class="mock-stat-bar">
              <div class="stat-pill-sm">
                <span class="lbl">CALORIES</span>
                <span class="val text-green">1,247 / 1,700 kcal</span>
              </div>
              <div class="stat-pill-sm">
                <span class="lbl">DEFICIT</span>
                <span class="val text-cyan">-453 kcal</span>
              </div>
            </div>
            <div class="mock-macro-row">
              <div class="macro-bubble">
                <span class="m-val text-green">142g</span>
                <span class="m-lbl">Protein</span>
              </div>
              <div class="macro-bubble">
                <span class="m-val text-cyan">185g</span>
                <span class="m-lbl">Carbs</span>
              </div>
              <div class="macro-bubble">
                <span class="m-val text-orange">44g</span>
                <span class="m-lbl">Fats</span>
              </div>
            </div>
            <div class="mock-chip-offline">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>100% Offline &middot; Zero Cloud Sync Required</span>
            </div>
          </div>
        </div>

        <!-- Specifications Matrix -->
        <div class="product-specs">
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            <span>Android 8.0+</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span id="kfitSizeText">~170 MB APK</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
            <span>Zero Google Play Tracking</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>No Account Needed</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="product-actions">
          <a
            href={KFIT_APK_URL}
            class="btn btn-primary btn-kfit-dl"
            id="kfitMainDlBtn"
            download="kfit.apk"
          >
            <svg class="dl-arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
            </svg>
            <span class="btn-text">Download KFit APK</span>
          </a>
          <a
            href={KFIT_RELEASES_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            title="View changelog and all GitHub releases"
          >
            <span>All Releases</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </a>
        </div>
      </article>

      <!-- ================= PRODUCT 2: KFIT WEB ================= -->
      <article class="product-card card-web" data-category="kfit-web">
        <div class="card-spotlight" aria-hidden="true"></div>
        <div class="card-ambient-light light-cyan" aria-hidden="true"></div>

        <div class="product-card-top">
          <div class="brand-row">
            <div class="app-icon icon-web">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </div>
            <div class="brand-meta">
              <div class="product-category">Web Platform &middot; Installable PWA</div>
              <h3 class="product-name">KFit Web</h3>
            </div>
          </div>
          <div class="release-pill pill-cyan">
            <span class="mini-live-dot"></span>
            <span>getkfit.app &middot; Live</span>
          </div>
        </div>

        <p class="product-desc">
          The expansive desktop experience.
          Engineered for widescreen clarity and rapid keyboard entry (<code class="apple-code">⌘K</code>). Instant food lookup, multi-week deficit trends, and seamless cross-device sync with Android.
        </p>

        <!-- Interactive In-Card Mockup -->
        <div class="card-mockup-frame">
          <div class="mockup-header">
            <span class="mock-dot red"></span>
            <span class="mock-dot yellow"></span>
            <span class="mock-dot green"></span>
            <span class="mock-title">getkfit.app &middot; live sync</span>
            <span class="mock-badge-live">CONNECTED</span>
          </div>
          <div class="mockup-body mockup-web-body">
            <div class="mock-browser-search">
              <span class="mock-search-icon">🔍</span>
              <span class="mock-search-text">Search 700+ Indian foods or press <kbd>⌘K</kbd></span>
            </div>
            <div class="mock-web-insights">
              <div class="web-insight-chip">
                <span class="chip-dot"></span>
                <span>Weekly Deficit: -3,150 kcal (On track for 0.45kg fat loss)</span>
              </div>
              <div class="web-insight-tags">
                <span class="tag">PWA Ready</span>
                <span class="tag">Offline First</span>
                <span class="tag">Zero Install</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Specifications Matrix -->
        <div class="product-specs">
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
            <span>Chrome, Safari, Firefox</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
            <span>Cross-Device Cloud Sync</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>Desktop &amp; Tablet Optimized</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Instant Load &middot; No Setup</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="product-actions">
          <a
            href={KFIT_WEB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-web-launch"
          >
            <span>Launch KFit Web</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </a>
          <a
            href={KFIT_WEB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            <span>getkfit.app</span>
          </a>
        </div>
      </article>

      <!-- ================= PRODUCT 3: GYMWORLD ================= -->
      <article class="product-card card-gymworld" data-category="gymworld">
        <div class="card-spotlight" aria-hidden="true"></div>
        <div class="card-ambient-light light-orange" aria-hidden="true"></div>

        <div class="product-card-top">
          <div class="brand-row">
            <div class="app-icon icon-gymworld">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 5v14M18 5v14M2 9v6M22 9v6M6 12h12"/>
              </svg>
            </div>
            <div class="brand-meta">
              <div class="product-category">Studio Platform &middot; Gyms &amp; Coaches</div>
              <h3 class="product-name">GymWorld</h3>
            </div>
          </div>
          <div class="release-pill pill-orange">
            <span class="mini-live-dot"></span>
            <span>gymworld.getkfit.app</span>
          </div>
        </div>

        <p class="product-desc">
          The operating system for modern gyms and strength coaches.
          Renewal desk, member workflows, active training plans, and immediate customer contact — without messy spreadsheets.
        </p>

        <!-- Interactive In-Card Mockup -->
        <div class="card-mockup-frame">
          <div class="mockup-header">
            <span class="mock-dot red"></span>
            <span class="mock-dot yellow"></span>
            <span class="mock-dot green"></span>
            <span class="mock-title">gymworld.getkfit.app &middot; facility portal</span>
            <span class="mock-badge-live">LIVE</span>
          </div>
          <div class="mockup-body mockup-gym-body">
            <div class="gym-stats-row">
              <div class="gym-stat-box">
                <span class="stat-number text-orange">184</span>
                <span class="stat-label">Active Athletes</span>
              </div>
              <div class="gym-stat-box">
                <span class="stat-number text-green">98.2%</span>
                <span class="stat-label">Retention Rate</span>
              </div>
              <div class="gym-stat-box">
                <span class="stat-number text-cyan">42</span>
                <span class="stat-label">In Facility Now</span>
              </div>
            </div>
            <div class="gym-activity-stream">
              <div class="stream-item">
                <span class="check-icon">✓</span>
                <span class="stream-text">Athlete checked in &middot; Morning Strength Block</span>
                <span class="stream-time">Just now</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Specifications Matrix -->
        <div class="product-specs">
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Gyms, Studios &amp; Trainers</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span>Attendance &amp; Member Logs</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Coaching Schedules</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Live Web Dashboard</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="product-actions">
          <a
            href={GYMWORLD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-gym-launch"
          >
            <span>Open GymWorld</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </a>
          <a
            href={GYMWORLD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            <span>gymworld.getkfit.app</span>
          </a>
        </div>
      </article>

      <!-- ================= PRODUCT 4: JARVIS ================= -->
      <article class="product-card card-jarvis" data-category="jarvis">
        <div class="card-spotlight" aria-hidden="true"></div>
        <div class="card-ambient-light light-purple" aria-hidden="true"></div>

        <div class="product-card-top">
          <div class="brand-row">
            <div class="app-icon icon-jarvis">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" y1="19" x2="12" y2="23"/>
                <line x1="8" y1="23" x2="16" y2="23"/>
              </svg>
            </div>
            <div class="brand-meta">
              <div class="product-category">Companion OS &middot; Ambient Voice</div>
              <h3 class="product-name">JARVIS</h3>
            </div>
          </div>
          <div class="release-pill pill-purple" id="jarvisTagPill">
            <span class="mini-live-dot"></span>
            <span id="jarvisVersionText">Companion APK</span>
          </div>
        </div>

        <p class="product-desc">
          Ambient voice intelligence linked directly to KFit via Android AIDL (<code class="apple-code">IKFitToolService</code>).
          Record sets, log nutrition, and track hydration between exercises by simply speaking. Zero friction, zero screen taps.
        </p>

        <!-- Interactive In-Card Mockup -->
        <div class="card-mockup-frame">
          <div class="mockup-header">
            <span class="mock-dot red"></span>
            <span class="mock-dot yellow"></span>
            <span class="mock-dot green"></span>
            <span class="mock-title">jarvis.apk &middot; binder active</span>
            <span class="mock-badge-live">IPC CONNECTED</span>
          </div>
          <div class="mockup-body mockup-jarvis-body">
            <!-- Animated audio waveform -->
            <div class="waveform-box">
              <div class="wave-bar w1"></div>
              <div class="wave-bar w2"></div>
              <div class="wave-bar w3"></div>
              <div class="wave-bar w4"></div>
              <div class="wave-bar w5"></div>
              <div class="wave-bar w6"></div>
              <div class="wave-bar w7"></div>
              <div class="wave-bar w8"></div>
              <span class="wave-status">Edge Voice Stream &middot; Zero Latency</span>
            </div>
            <div class="jarvis-dialogue">
              <div class="jarvis-user-bubble">
                &ldquo;Log 3 rotis and 1 bowl paneer bhurji for dinner.&rdquo;
              </div>
              <div class="jarvis-reply-bubble">
                <span class="reply-badge">JARVIS</span>
                <span>Logged 480 kcal (32g protein) directly to KFit. Daily deficit safely intact.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Specifications Matrix -->
        <div class="product-specs">
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            <span>Android 10+</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span id="jarvisSizeText">~55 MB APK</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span>Direct AIDL Binder to KFit</span>
          </div>
          <div class="spec-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Hands-Free Speech Recognition</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="product-actions">
          <a
            href={JARVIS_APK_URL}
            class="btn btn-primary btn-jarvis-dl"
            id="jarvisMainDlBtn"
            download="jarvis.apk"
          >
            <svg class="dl-arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
            </svg>
            <span class="btn-text">Download JARVIS APK</span>
          </a>
          <a
            href={KFIT_RELEASES_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            title="View JARVIS releases on GitHub"
          >
            <span>Releases</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </a>
        </div>
      </article>

    </div>

    <!-- ================= AMY INSPIRATION: DYNAMIC INTERACTIVE NOTE TESTER ================= -->
    <div class="amy-section">
      <div class="amy-header">
        <span class="section-label">Intuitive Craft</span>
        <h3 class="amy-title">Track like writing in Apple Notes.</h3>
        <p class="amy-subtitle">
          No nested menus. No barcode paywalls. Just type what you ate — our verified Indian nutrition database calculates energy, protein, and macros dynamically.
        </p>
      </div>

      <!-- Interactive Apple Notes Tester -->
      <div class="interactive-food-box">
        <div class="note-app-header">
          <div class="note-header-left">
            <span class="note-icon-folder">📁</span>
