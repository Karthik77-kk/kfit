<script>
  import gsap from 'gsap';

  // 1. Apple Segmented Control Filtering
  const segBtns = document.querySelectorAll('.seg-btn');
  const cards = document.querySelectorAll('.bento-card');
  const segPillBg = document.getElementById('segPillBg');

  const updatePill = (btn: HTMLElement) => {
    if (!segPillBg) return;
    const parentRect = btn.parentElement?.getBoundingClientRect();
    const btnRect = btn.getBoundingClientRect();
    if (parentRect) {
      segPillBg.style.left = `${btnRect.left - parentRect.left}px`;
      segPillBg.style.width = `${btnRect.width}px`;
    }
  };

  const initialActive = document.querySelector('.seg-btn.active') as HTMLElement | null;
  if (initialActive) updatePill(initialActive);

  window.addEventListener('load', () => {
    const active = document.querySelector('.seg-btn.active') as HTMLElement | null;
    if (active) updatePill(active);
  });

  segBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      segBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      updatePill(btn as HTMLElement);

      const filter = btn.getAttribute('data-filter');
      cards.forEach((card) => {
        const c = card as HTMLElement;
        const category = c.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          gsap.to(c, {
            opacity: 1,
            scale: 1,
            duration: 0.35,
            ease: 'power2.out',
            clearProps: 'display',
          });
          c.style.display = 'flex';
        } else {
          gsap.to(c, {
            opacity: 0,
            scale: 0.96,
            duration: 0.25,
            ease: 'power2.in',
            onComplete: () => {
              c.style.display = 'none';
            },
          });
        }
      });
    });
  });

  window.addEventListener('resize', () => {
    const active = document.querySelector('.seg-btn.active') as HTMLElement | null;
    if (active) updatePill(active);
  });

  // 2. Cursor Spotlight Tracking
  cards.forEach((card) => {
    card.addEventListener('mousemove', (e: Event) => {
      const mouseEvent = e as MouseEvent;
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = mouseEvent.clientX - rect.left;
      const y = mouseEvent.clientY - rect.top;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // 3. Dynamic GitHub Release Fetcher
  async function updateReleaseInfo() {
    try {
      const res = await fetch('https://api.github.com/repos/Karthik77-kk/kfit/releases');
      if (!res.ok) return;
      const releases = await res.json();
      if (!Array.isArray(releases) || releases.length === 0) return;

      const kfitRelease = releases.find((r: any) =>
        r.assets && r.assets.some((a: any) => a.name === 'kfit.apk')
      );
      if (kfitRelease) {
        const kfitAsset = kfitRelease.assets.find((a: any) => a.name === 'kfit.apk');
        const kfitDlBtn = document.getElementById('kfitMainDlBtn') as HTMLAnchorElement | null;
        const heroDlBtn = document.getElementById('heroDlBtn') as HTMLAnchorElement | null;
        const kfitVersionText = document.getElementById('kfitVersionText');
        const kfitSizeText = document.getElementById('kfitSizeText');

        if (kfitDlBtn && kfitAsset?.browser_download_url) kfitDlBtn.href = kfitAsset.browser_download_url;
        if (heroDlBtn && kfitAsset?.browser_download_url) heroDlBtn.href = kfitAsset.browser_download_url;
        if (kfitVersionText && kfitRelease.tag_name) kfitVersionText.textContent = `${kfitRelease.tag_name}`;
        if (kfitSizeText && kfitAsset?.size) {
          const mb = (kfitAsset.size / (1024 * 1024)).toFixed(0);
          kfitSizeText.textContent = `~${mb} MB APK`;
        }
      }

      const jarvisRelease = releases.find((r: any) =>
        (r.tag_name && r.tag_name.includes('jarvis')) ||
        (r.assets && r.assets.some((a: any) => a.name === 'jarvis.apk'))
      );
      if (jarvisRelease) {
        const jarvisAsset = jarvisRelease.assets.find((a: any) => a.name === 'jarvis.apk');
        const jarvisDlBtn = document.getElementById('jarvisMainDlBtn') as HTMLAnchorElement | null;
        const jarvisVersionText = document.getElementById('jarvisVersionText');
        const jarvisSizeText = document.getElementById('jarvisSizeText');

        if (jarvisDlBtn && jarvisAsset?.browser_download_url) jarvisDlBtn.href = jarvisAsset.browser_download_url;
        if (jarvisVersionText && jarvisRelease.tag_name) jarvisVersionText.textContent = `${jarvisRelease.tag_name}`;
        if (jarvisSizeText && jarvisAsset?.size) {
          const mb = (jarvisAsset.size / (1024 * 1024)).toFixed(0);
          jarvisSizeText.textContent = `~${mb} MB APK`;
        }
      }
    } catch {
      // Fallback to default urls
    }
  }
  updateReleaseInfo();

  // 4. Download Feedback Micro-Interactions
  const setupDownloadFeedback = (btnId: string, originalText: string) => {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.addEventListener('click', () => {
      const textSpan = btn.querySelector('.btn-text');
      if (textSpan) textSpan.textContent = 'Starting Download…';
      btn.style.opacity = '0.85';
      setTimeout(() => {
        if (textSpan) textSpan.textContent = originalText;
        btn.style.opacity = '1';
      }, 3000);
    });
  };
  setupDownloadFeedback('heroDlBtn', 'Download KFit for Android');
  setupDownloadFeedback('kfitMainDlBtn', 'Download KFit APK');
  setupDownloadFeedback('jarvisMainDlBtn', 'Download JARVIS APK');

  // 5. Amy Food Journal Reactive Dynamic Calculation
  const mealPresets: Record<string, { text: string; cal: number; pro: number; carb: number; fat: number; source: string }> = {
    dosa: {
      text: '2 Masala Dosas with coconut chutney, sambar, and 1 tumbler filter coffee',
      cal: 510,
      pro: 14.2,
      carb: 74.5,
      fat: 16.8,
      source: 'Verified with IFCT-2017 Indian Food Database · 100% Offline',
    },
    lunch: {
      text: '200g Paneer tikka, 2 whole wheat rotis, 1 cup dal tadka, cucumber salad',
      cal: 685,
      pro: 38.4,
      carb: 56.2,
      fat: 28.1,
      source: 'Verified with IFCT-2017 Database · High protein bio-availability score: 94%',
    },
    workout: {
      text: '1 scoop whey protein isolate in water, 1 large robusta banana, 8 almonds',
      cal: 315,
      pro: 27.8,
      carb: 34.0,
      fat: 6.4,
      source: 'Computed on-device · Fast-absorbing post-workout recovery target reached',
    },
    snack: {
      text: '1 cup roasted chana, 1 tender coconut water, 1 apple',
      cal: 260,
      pro: 11.5,
      carb: 46.0,
      fat: 3.2,
      source: 'Verified with IFCT-2017 National Database · Low glycemic index',
    },
  };

  const foodDictionary: Array<{ keywords: string[]; cal: number; pro: number; carb: number; fat: number }> = [
    { keywords: ['dosa', 'dosas'], cal: 175, pro: 4.2, carb: 30, fat: 4.5 },
    { keywords: ['masala dosa'], cal: 260, pro: 5.5, carb: 38, fat: 8.5 },
    { keywords: ['idli', 'idlis'], cal: 58, pro: 2.1, carb: 12, fat: 0.3 },
    { keywords: ['sambar'], cal: 65, pro: 3.2, carb: 10, fat: 1.5 },
    { keywords: ['chutney', 'coconut chutney'], cal: 70, pro: 1.2, carb: 3.5, fat: 6.2 },
    { keywords: ['roti', 'rotis', 'chapati', 'chapatis'], cal: 105, pro: 3.5, carb: 20, fat: 1.2 },
    { keywords: ['paneer', 'paneer tikka', 'bhurji'], cal: 290, pro: 18.5, carb: 4.2, fat: 22 },
    { keywords: ['dal', 'dal tadka'], cal: 140, pro: 8.5, carb: 19, fat: 3.2 },
    { keywords: ['rice', 'biryani'], cal: 210, pro: 4.5, carb: 44, fat: 2.1 },
    { keywords: ['egg', 'eggs'], cal: 78, pro: 6.5, carb: 0.6, fat: 5.2 },
    { keywords: ['chicken', 'chicken breast'], cal: 165, pro: 31, carb: 0, fat: 3.6 },
    { keywords: ['whey', 'protein shake', 'whey protein'], cal: 120, pro: 25, carb: 2.0, fat: 1.5 },
    { keywords: ['coffee', 'filter coffee'], cal: 50, pro: 1.8, carb: 6.5, fat: 1.6 },
    { keywords: ['banana'], cal: 105, pro: 1.3, carb: 27, fat: 0.3 },
    { keywords: ['apple'], cal: 95, pro: 0.5, carb: 25, fat: 0.3 },
    { keywords: ['almonds', 'nuts'], cal: 80, pro: 2.8, carb: 3.0, fat: 7.0 },
    { keywords: ['chana', 'roasted chana'], cal: 120, pro: 6.5, carb: 19, fat: 2.0 },
    { keywords: ['coconut water'], cal: 45, pro: 1.0, carb: 10, fat: 0.2 },
  ];

  const noteInput = document.getElementById('interactiveNoteInput') as HTMLInputElement | null;
  const demoCal = document.getElementById('demoCalories');
  const demoPro = document.getElementById('demoProtein');
  const demoCarb = document.getElementById('demoCarbs');
  const demoFat = document.getElementById('demoFats');
  const demoSource = document.getElementById('demoSourceText');
  const mealBtns = document.querySelectorAll('.meal-sample-btn');

  function calculateNutrientsFromText(rawText: string) {
    const text = rawText.toLowerCase();
    let totalCal = 0;
    let totalPro = 0;
    let totalCarb = 0;
    let totalFat = 0;
    let matchedAny = false;

    for (const item of foodDictionary) {
      for (const kw of item.keywords) {
        if (text.includes(kw)) {
          matchedAny = true;
          const escapedKw = kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          const regex = new RegExp(`(\\d+)\\s*(?:x\\s*)?${escapedKw}`, 'i');
          const match = text.match(regex);
          const count = match ? Math.min(Math.max(parseInt(match[1], 10), 1), 10) : 1;

          totalCal += item.cal * count;
          totalPro += item.pro * count;
          totalCarb += item.carb * count;
          totalFat += item.fat * count;
          break;
        }
      }
    }

    if (!matchedAny) {
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      totalCal = Math.max(words * 85, 120);
      totalPro = +(totalCal * 0.05).toFixed(1);
      totalCarb = +(totalCal * 0.14).toFixed(1);
      totalFat = +(totalCal * 0.03).toFixed(1);
    }

    return {
      cal: Math.round(totalCal),
      pro: +totalPro.toFixed(1),
      carb: +totalCarb.toFixed(1),
      fat: +totalFat.toFixed(1),
    };
  }

  let currentNutrients = { cal: 510, pro: 14.2, carb: 74.5, fat: 16.8 };

  function animateNutrientValues(cal: number, pro: number, carb: number, fat: number) {
    gsap.killTweensOf(currentNutrients);
    gsap.to(currentNutrients, {
      cal,
      pro,
      carb,
      fat,
      duration: 0.35,
      ease: 'power2.out',
      onUpdate: () => {
        if (demoCal) demoCal.textContent = Math.round(currentNutrients.cal).toString();
        if (demoPro) demoPro.textContent = currentNutrients.pro.toFixed(1);
        if (demoCarb) demoCarb.textContent = currentNutrients.carb.toFixed(1);
        if (demoFat) demoFat.textContent = currentNutrients.fat.toFixed(1);
      },
    });
  }

  mealBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      mealBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const mealKey = btn.getAttribute('data-meal');
      if (mealKey && mealPresets[mealKey] && noteInput) {
        const data = mealPresets[mealKey];
        noteInput.value = data.text;
        animateNutrientValues(data.cal, data.pro, data.carb, data.fat);
        if (demoSource) demoSource.textContent = data.source;
      }
    });
  });

  if (noteInput) {
    noteInput.addEventListener('input', () => {
      mealBtns.forEach((b) => b.classList.remove('active'));
      const text = noteInput.value.trim();
      if (!text) {
        animateNutrientValues(0, 0, 0, 0);
        return;
      }
      const result = calculateNutrientsFromText(text);
      animateNutrientValues(result.cal, result.pro, result.carb, result.fat);
      if (demoSource) demoSource.textContent = 'Calculated dynamically via verified Indian nutrition profile';
    });
  }
</script>

