    background: radial-gradient(circle, #30D158 0%, transparent 70%);
  }

  .dl-glow-cyan {
    top: 35%;
    right: 5%;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, #40C8E0 0%, transparent 70%);
  }

  .dl-glow-violet {
    bottom: 10%;
    left: 20%;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, #BF5AF2 0%, transparent 70%);
  }

  /* ── Header ───────────────────────────────────────────────────────────────── */
  .hub-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 56px auto;
    position: relative;
    z-index: 1;
  }

  .hub-tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green);
    background: rgba(48, 209, 88, 0.08);
    border: 1px solid rgba(48, 209, 88, 0.22);
    border-radius: 100px;
    padding: 6px 16px;
    margin-bottom: 20px;
  }

  .pulse-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px var(--green);
    animation: dot-pulse 2s infinite ease-in-out;
  }

  .hub-title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin-bottom: 18px;
  }

  .hub-subtitle {
    font-size: clamp(16px, 2vw, 19px);
    color: var(--muted);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto 36px auto;
  }

  /* ── Apple Segmented Control ──────────────────────────────────────────────── */
  .segmented-control {
    position: relative;
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 100px;
    padding: 5px;
    gap: 2px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .segmented-control::-webkit-scrollbar { display: none; }

  .seg-pill-bg {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: 0;
    background: #ffffff;
    border-radius: 100px;
    pointer-events: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    z-index: 0;
  }

  .seg-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 100px;
    cursor: pointer;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.12s ease;
    white-space: nowrap;
    font-family: var(--font);
  }

  .seg-btn:active {
    transform: scale(0.97);
  }

  .seg-btn:hover {
    color: #fff;
  }

  .seg-btn.active {
    color: #000000;
  }

  .seg-count {
    font-size: 11px;
    background: rgba(0, 0, 0, 0.12);
    padding: 2px 7px;
    border-radius: 10px;
  }

  .seg-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot-green { background: var(--green); }
  .dot-cyan { background: var(--cyan); }
  .dot-orange { background: var(--orange); }
  .dot-purple { background: var(--purple); }

  /* ── Bento Products Grid ──────────────────────────────────────────────────── */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    position: relative;
    z-index: 1;
    margin-bottom: 90px;
  }

  .product-card {
    background: rgba(24, 24, 26, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(28px) saturate(190%);
    -webkit-backdrop-filter: blur(28px) saturate(190%);
    border-radius: 28px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
  }

  /* Card Cursor Spotlight */
  .card-spotlight {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    background: radial-gradient(400px circle at var(--mouse-x, -500px) var(--mouse-y, -500px), rgba(255, 255, 255, 0.06), transparent 70%);
    z-index: 0;
  }

  .card-ambient-light {
    position: absolute;
    top: 0;
    right: 0;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    filter: blur(75px);
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }

  .light-green  { background: radial-gradient(circle, #30D158 0%, transparent 70%); }
  .light-cyan   { background: radial-gradient(circle, #40C8E0 0%, transparent 70%); }
  .light-orange { background: radial-gradient(circle, #FF9F0A 0%, transparent 70%); }
  .light-purple { background: radial-gradient(circle, #BF5AF2 0%, transparent 70%); }

  /* Card Top */
  .product-card-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .brand-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .app-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .icon-kfit { background: linear-gradient(135deg, #30D158, #1ba33c); }
  .icon-web { background: linear-gradient(135deg, #40C8E0, #1495ad); }
  .icon-gymworld { background: linear-gradient(135deg, #FF9F0A, #d97800); }
  .icon-jarvis { background: linear-gradient(135deg, #BF5AF2, #8e2bbf); }

  .icon-letter {
    font-size: 24px;
    font-weight: 900;
    color: #000;
    letter-spacing: -1px;
  }

  .brand-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .product-category {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .product-name {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .release-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 100px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .pill-green {
    background: rgba(48, 209, 88, 0.1);
    color: var(--green);
    border: 1px solid rgba(48, 209, 88, 0.25);
  }

  .pill-cyan {
    background: rgba(64, 200, 224, 0.1);
    color: var(--cyan);
    border: 1px solid rgba(64, 200, 224, 0.25);
  }

  .pill-orange {
    background: rgba(255, 159, 10, 0.1);
    color: var(--orange);
    border: 1px solid rgba(255, 159, 10, 0.25);
  }

  .pill-purple {
    background: rgba(191, 90, 242, 0.1);
    color: var(--purple);
    border: 1px solid rgba(191, 90, 242, 0.25);
  }

  .mini-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .product-desc {
    position: relative;
    z-index: 1;
    font-size: 14.5px;
    color: #a1a1a6;
    line-height: 1.62;
    min-height: 68px;
  }

  .apple-code {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 5px;
    padding: 2px 6px;
    font-size: 12px;
    color: #e4e4e7;
    font-family: monospace;
  }

  /* ── Card Mockup Frame ────────────────────────────────────────────────────── */
  .card-mockup-frame {
    position: relative;
    z-index: 1;
    background: #0d0d0e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    overflow: hidden;
  }

  .mockup-header {
    background: #141416;
    padding: 9px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mock-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .mock-dot.red { background: #FF453A; }
  .mock-dot.yellow { background: #FF9F0A; }
  .mock-dot.green { background: #30D158; }

  .mock-title {
    font-size: 11px;
    font-family: monospace;
    color: var(--muted2);
    margin-left: 6px;
    letter-spacing: 0.02em;
  }

  .mock-badge-live {
    margin-left: auto;
    font-size: 9px;
    font-weight: 700;
    color: var(--green);
    letter-spacing: 0.06em;
  }

  .mockup-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* KFit Mobile Mockup Items */
  .mock-stat-bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .stat-pill-sm {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 8px 12px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .stat-pill-sm .lbl {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .stat-pill-sm .val {
    font-size: 13.5px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .text-green { color: var(--green); }
  .text-cyan { color: var(--cyan); }
  .text-orange { color: var(--orange); }
  .text-purple { color: var(--purple); }

  .mock-macro-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .macro-bubble {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 8px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-val { font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .m-lbl { font-size: 10px; color: var(--muted); }

  .mock-chip-offline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--green);
    background: rgba(48, 209, 88, 0.07);
    border: 1px solid rgba(48, 209, 88, 0.18);
    border-radius: 8px;
    padding: 6px 12px;
    justify-content: center;
  }

  /* Web Mockup */
  .mock-browser-search {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 9px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
  }

  kbd {
    background: #27272a;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 10px;
    color: #fff;
    font-family: inherit;
  }

  .mock-web-insights {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .web-insight-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #fff;
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    flex-shrink: 0;
  }

  .web-insight-tags {
    display: flex;
    gap: 6px;
  }

  .tag {
    font-size: 10px;
    font-weight: 600;
    background: rgba(64, 200, 224, 0.1);
    color: var(--cyan);
    border: 1px solid rgba(64, 200, 224, 0.2);
    border-radius: 6px;
    padding: 3px 8px;
  }

  /* GymWorld Mockup */
  .gym-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .gym-stat-box {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 8px 6px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .stat-number { font-size: 16px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .stat-label { font-size: 10px; color: var(--muted); }

  .gym-activity-stream {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 8px 12px;
  }

  .stream-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #fff;
  }

  .check-icon {
    color: var(--green);
    font-weight: 700;
  }

  .stream-time {
    margin-left: auto;
    font-size: 10px;
    color: var(--muted2);
  }

  /* JARVIS Mockup */
  .waveform-box {
    background: #18181b;
    border: 1px solid rgba(191, 90, 242, 0.2);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .wave-bar {
    width: 3px;
    border-radius: 3px;
    background: var(--purple);
    animation: wave-pulse 1.2s infinite ease-in-out;
  }

  .w1 { height: 12px; animation-delay: 0.1s; }
  .w2 { height: 20px; animation-delay: 0.2s; }
  .w3 { height: 14px; animation-delay: 0.3s; }
  .w4 { height: 24px; animation-delay: 0.4s; }
  .w5 { height: 16px; animation-delay: 0.5s; }
  .w6 { height: 22px; animation-delay: 0.6s; }
  .w7 { height: 10px; animation-delay: 0.7s; }
  .w8 { height: 18px; animation-delay: 0.8s; }

  @keyframes wave-pulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.6; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  .wave-status {
    font-size: 11px;
    color: var(--purple);
    margin-left: auto;
    font-weight: 500;
  }

  .jarvis-dialogue {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .jarvis-user-bubble {
    font-size: 11px;
    color: #d1d1d6;
    background: rgba(255, 255, 255, 0.05);
    padding: 6px 10px;
    border-radius: 8px;
    font-style: italic;
  }

  .jarvis-reply-bubble {
    font-size: 11.5px;
    color: #fff;
    background: rgba(191, 90, 242, 0.1);
    border: 1px solid rgba(191, 90, 242, 0.2);
    padding: 7px 10px;
    border-radius: 8px;
    display: flex;
    align-items: baseline;
    gap: 6px;
    line-height: 1.4;
  }

  .reply-badge {
    font-size: 9px;
    font-weight: 800;
    background: var(--purple);
    color: #000;
    padding: 1px 5px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  /* Specifications */
  .product-specs {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 14px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #a1a1a6;
  }

  .spec-item svg {
    color: #8E8E93;
    flex-shrink: 0;
  }

  /* Actions */
  .product-actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-kfit-dl {
    background: var(--green);
    color: #000;
    font-weight: 700;
    flex: 1;
    justify-content: center;
  }

  .btn-kfit-dl:hover {
    background: #3de06a;
    box-shadow: 0 0 35px rgba(48, 209, 88, 0.45);
  }

  .btn-web-launch {
    background: var(--cyan);
    color: #000;
    font-weight: 700;
    flex: 1;
    justify-content: center;
  }

  .btn-web-launch:hover {
    background: #50d5ec;
    box-shadow: 0 0 35px rgba(64, 200, 224, 0.45);
  }

  .btn-gym-launch {
    background: var(--orange);
    color: #000;
    font-weight: 700;
    flex: 1;
    justify-content: center;
  }

  .btn-gym-launch:hover {
    background: #ffab26;
    box-shadow: 0 0 35px rgba(255, 159, 10, 0.45);
  }

  .btn-jarvis-dl {
    background: var(--purple);
    color: #000;
    font-weight: 700;
    flex: 1;
    justify-content: center;
  }

  .btn-jarvis-dl:hover {
    background: #cb6eff;
    box-shadow: 0 0 35px rgba(191, 90, 242, 0.45);
  }

  .btn:active {
    transform: scale(0.975);
  }

  /* ── Amy Food Journal Section ─────────────────────────────────────────────── */
  .amy-section {
    background: rgba(24, 24, 26, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px;
    padding: 48px;
    margin-bottom: 90px;
    position: relative;
    z-index: 1;
  }

  .amy-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 36px auto;
  }

  .amy-title {
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    letter-spacing: -0.03em;
    font-weight: 800;
    margin-bottom: 14px;
    color: #fff;
  }

  .amy-subtitle {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.6;
  }

  .interactive-food-box {
    max-width: 780px;
    margin: 0 auto;
    background: #0d0d0e;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  .note-app-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .note-header-left {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #d1d1d6;
  }

  .note-badge-device {
    font-size: 11px;
    font-weight: 600;
    color: var(--green);
    background: rgba(48, 209, 88, 0.1);
    border: 1px solid rgba(48, 209, 88, 0.2);
    border-radius: 100px;
    padding: 3px 10px;
  }

  .food-tabs-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted2);
    margin-bottom: 12px;
  }

  .sample-meal-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .meal-sample-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: var(--muted);
    border-radius: 100px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font);
  }

  .meal-sample-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .meal-sample-btn.active {
    background: rgba(48, 209, 88, 0.15);
    border-color: var(--green);
    color: var(--green);
  }

  .meal-sample-btn:active {
    transform: scale(0.96);
  }

  .meal-result-card {
    background: #141417;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .meal-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meal-input-display {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 14px;
    transition: border-color 0.2s ease;
  }

  .meal-input-display:focus-within {
    border-color: var(--green);
    box-shadow: 0 0 16px rgba(48, 209, 88, 0.2);
  }

  .note-cursor {
    color: var(--green);
    font-weight: 800;
    font-size: 16px;
  }

  .note-live-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 14.5px;
    color: #fff;
    font-family: var(--font);
    font-weight: 500;
  }

  .note-live-input::placeholder {
