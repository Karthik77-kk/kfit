---
import releases from '../data/releases.json';

const { kfit, jarvis, web, gymworld } = releases;

interface Props {
  isStandalone?: boolean;
}

const { isStandalone = false } = Astro.props;
---

<section class={`ecosystem-root ${isStandalone ? 'standalone-hub' : ''}`} id="ecosystem">
  <!-- Subtle monochromatic ambient lighting -->
  <div class="ambient-glow ambient-glow-top" aria-hidden="true"></div>

  <div class="container">
    <!-- ── 1. Hero Section ──────────────────────────────────────────────────── -->
    <div class="hero-block">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>The KFit Ecosystem &middot; Private Fitness &amp; Nutrition</span>
      </div>

      <h1 class="hero-title">
        Fitness tracking that stays out of your way.
      </h1>

      <p class="hero-subtitle">
        Log Indian meals in plain language. Track workouts, body composition, hydration and trends locally on your device. Create an account only when you want cross-device sync.
      </p>

      <div class="hero-actions">
        <a href="/downloads/kfit" class="btn btn-primary hero-btn-dl" id="heroDlBtn" download="kfit.apk" title={`Download KFit APK (${kfit.version}, ${kfit.sizeFormatted})`}>
          <svg class="dl-arrow-icon" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
          </svg>
          <span class="btn-text">Download KFit for Android</span>
        </a>
        <a href={web.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost hero-btn-web">
          <span>Open KFit Web</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
      </div>

      <div class="hero-trust-bar">
        <span>No subscription</span>
        <span class="trust-sep">&bull;</span>
        <span>Works offline</span>
        <span class="trust-sep">&bull;</span>
        <span>Account optional</span>
      </div>

      <!-- ── Hero Product Narrative Composition (900-1100px wide) ──────────── -->
      <div class="hero-narrative-frame" id="heroNarrative">
        <div class="narrative-nav" role="tablist" aria-label="Tracking narrative stages">
          <button class="n-tab active" data-step="1" role="tab" aria-selected="true" id="tab-step-1">
            <span class="n-step-num">1</span>
            <span class="n-step-name">Natural meal input</span>
          </button>
          <span class="n-tab-divider" aria-hidden="true">&rarr;</span>
          <button class="n-tab" data-step="2" role="tab" aria-selected="false" id="tab-step-2">
            <span class="n-step-num">2</span>
            <span class="n-step-name">Deterministic resolution</span>
          </button>
          <span class="n-tab-divider" aria-hidden="true">&rarr;</span>
          <button class="n-tab" data-step="3" role="tab" aria-selected="false" id="tab-step-3">
            <span class="n-step-num">3</span>
            <span class="n-step-name">Daily nutrition summary</span>
          </button>
          <span class="n-tab-divider" aria-hidden="true">&rarr;</span>
          <button class="n-tab" data-step="4" role="tab" aria-selected="false" id="tab-step-4">
            <span class="n-step-num">4</span>
            <span class="n-step-name">Today's balance</span>
          </button>
        </div>

        <div class="narrative-card">
          <!-- Step 1: Input -->
          <div class="narrative-pane active" id="pane-1" role="tabpanel" aria-labelledby="tab-step-1">
            <div class="pane-meta">
              <span class="pane-tag">Plain language input</span>
              <span class="pane-sub">No nested menus &middot; Just type what you ate</span>
            </div>
            <div class="sample-input-box">
              <span class="input-chevron">&gt;</span>
              <span class="input-text">2 Masala Dosas with coconut chutney, sambar, and 1 tumbler filter coffee</span>
            </div>
            <div class="pane-footnote">
              <span>Typed on mobile or spoken hands-free via JARVIS</span>
            </div>
          </div>

          <!-- Step 2: Resolution -->
          <div class="narrative-pane" id="pane-2" role="tabpanel" aria-labelledby="tab-step-2" hidden>
            <div class="pane-meta">
              <span class="pane-tag">Source-aware provenance</span>
              <span class="pane-sub">Matched against 848 curated dishes &middot; 528 IFCT lab items</span>
            </div>
            <div class="resolved-items-grid">
              <div class="resolved-row">
                <span class="item-name">2 &times; Masala Dosa</span>
                <span class="item-source badge-curated">Curated KFit foods</span>
                <span class="item-portion">2 servings (~240g)</span>
                <span class="item-kcal">330 kcal</span>
              </div>
              <div class="resolved-row">
                <span class="item-name">Coconut Chutney</span>
                <span class="item-source badge-curated">Curated KFit foods</span>
                <span class="item-portion">2 tbsp (~30g)</span>
                <span class="item-kcal">70 kcal</span>
              </div>
              <div class="resolved-row">
                <span class="item-name">Sambar</span>
                <span class="item-source badge-curated">Curated KFit foods</span>
                <span class="item-portion">1 katori (~150ml)</span>
                <span class="item-kcal">65 kcal</span>
              </div>
              <div class="resolved-row">
                <span class="item-name">Filter Coffee</span>
                <span class="item-source badge-ifct">IFCT 2017 &middot; Lab measured</span>
                <span class="item-portion">1 tumbler (~120ml)</span>
                <span class="item-kcal">45 kcal</span>
              </div>
            </div>
          </div>

          <!-- Step 3: Summary -->
          <div class="narrative-pane" id="pane-3" role="tabpanel" aria-labelledby="tab-step-3" hidden>
            <div class="pane-meta">
              <span class="pane-tag">Calculated meal totals</span>
              <span class="pane-sub">Verified macros derived from lab reference data</span>
            </div>
            <div class="hero-macros-grid">
              <div class="h-macro-card">
                <span class="h-macro-val">510</span>
                <span class="h-macro-unit">kcal</span>
                <span class="h-macro-label">Energy</span>
              </div>
              <div class="h-macro-card">
                <span class="h-macro-val">14.2</span>
                <span class="h-macro-unit">g</span>
                <span class="h-macro-label">Protein</span>
              </div>
              <div class="h-macro-card">
                <span class="h-macro-val">74.5</span>
                <span class="h-macro-unit">g</span>
                <span class="h-macro-label">Carbs</span>
              </div>
              <div class="h-macro-card">
                <span class="h-macro-val">16.8</span>
                <span class="h-macro-unit">g</span>
                <span class="h-macro-label">Fats</span>
              </div>
            </div>
          </div>

          <!-- Step 4: Today's View -->
          <div class="narrative-pane" id="pane-4" role="tabpanel" aria-labelledby="tab-step-4" hidden>
            <div class="pane-meta">
              <span class="pane-tag">Integrated daily rhythm</span>
              <span class="pane-sub">Stored locally in SQLite &middot; Zero telemetry</span>
            </div>
            <div class="today-overview-grid">
              <div class="today-stat-box">
                <span class="today-label">CALORIE BUDGET</span>
                <span class="today-val">1,247 / 1,700 kcal</span>
                <span class="today-sub text-green">On track (&minus;453 kcal deficit)</span>
              </div>
              <div class="today-stat-box">
                <span class="today-label">TRAINING BURN</span>
                <span class="today-val">310 kcal burned</span>
                <span class="today-sub">45m Strength Session (MET 6.0)</span>
              </div>
              <div class="today-stat-box">
                <span class="today-label">DAILY HYDRATION</span>
                <span class="today-val">2.4 / 3.0 L</span>
                <span class="today-sub">80% of daily target reached</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── 2. Natural Meal Logging Demo ────────────────────────────────────── -->
    <div class="journal-section" id="journal">
      <div class="section-heading">
        <span class="section-label">Natural Meal Logging</span>
        <h2 class="section-title">Just type what you ate.</h2>
        <p class="section-subtitle">
          No nested forms. No hunting through endless food lists. Write your meal naturally, review the resolved foods and portions, then save.
        </p>
      </div>

      <!-- Choreographed Canonical Demo Frame -->
      <div class="interactive-journal-frame">
        <div class="note-window-header">
          <div class="window-controls">
            <span class="win-dot close"></span>
            <span class="win-dot minimize"></span>
            <span class="win-dot zoom"></span>
            <span class="note-folder-name">Nutrition Journal &middot; Canonical Test Fixtures</span>
          </div>
          <div class="window-status-pill">
            <span>Example interaction</span>
          </div>
        </div>

        <div class="sample-meals-bar">
          <span class="sample-label">Canonical sample fixtures:</span>
          <div class="sample-pills" role="tablist" aria-label="Sample meal selections">
            <button class="meal-sample-btn active" data-fixture="dosa" role="tab" aria-selected="true">
              South Indian Breakfast
            </button>
            <button class="meal-sample-btn" data-fixture="lunch" role="tab" aria-selected="false">
              High-Protein Lunch
            </button>
            <button class="meal-sample-btn" data-fixture="recovery" role="tab" aria-selected="false">
              Whole Food Recovery
            </button>
            <button class="meal-sample-btn" data-fixture="workout" role="tab" aria-selected="false">
              Post-Workout Refuel
            </button>
          </div>
        </div>

        <div class="note-card-inner">
          <div class="note-input-container">
            <label for="interactiveNoteInput" class="sr-only">Type what you ate</label>
            <div class="note-input-field">
              <span class="note-prompt-symbol" aria-hidden="true">&gt;</span>
              <input
                type="text"
                id="interactiveNoteInput"
                class="note-live-input"
                value="2 Masala Dosas with coconut chutney, sambar, and 1 tumbler filter coffee"
                placeholder="Select a canonical meal above or test the input..."
                autocomplete="off"
                spellcheck="false"
              />
            </div>
            <div class="note-hint" id="demoHintText">
              Viewing canonical test fixture &middot; Values verified against KFit test suite.
            </div>
          </div>

          <div class="macros-grid">
            <div class="macro-cell">
              <span class="macro-value" id="demoCalories">510</span>
              <span class="macro-unit">kcal</span>
              <span class="macro-label">Energy</span>
            </div>
            <div class="macro-cell">
              <span class="macro-value" id="demoProtein">14.2</span>
              <span class="macro-unit">g</span>
              <span class="macro-label">Protein</span>
            </div>
            <div class="macro-cell">
              <span class="macro-value" id="demoCarbs">74.5</span>
              <span class="macro-unit">g</span>
              <span class="macro-label">Carbs</span>
            </div>
            <div class="macro-cell">
              <span class="macro-value" id="demoFats">16.8</span>
              <span class="macro-unit">g</span>
              <span class="macro-label">Fats</span>
            </div>
          </div>

          <div class="note-footer-meta">
            <div class="meta-left">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span id="demoSourceText">Source: Curated KFit foods &middot; IFCT 2017 portion reference</span>
            </div>
            <div class="meta-right">
              <span class="calc-badge">Deterministic Local Engine</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Provenance Layers Display -->
      <div class="provenance-strip">
        <div class="prov-card">
          <div class="prov-badge">Layer 1</div>
          <h4 class="prov-title">Curated KFit foods</h4>
          <p class="prov-desc">848 curated Indian dishes with authentic serving units (katori, roti, plate, glass).</p>
        </div>
        <div class="prov-card">
          <div class="prov-badge">Layer 2</div>
          <h4 class="prov-title">IFCT 2017</h4>
          <p class="prov-desc">528 ICMR-NIN lab-measured foods with precise raw and cooked micronutrient profiles.</p>
        </div>
        <div class="prov-card">
          <div class="prov-badge">Layer 3</div>
          <h4 class="prov-title">Optional online sources</h4>
          <p class="prov-desc">Open Food Facts and USDA fallbacks queried strictly when local tables lack a match.</p>
        </div>
      </div>
    </div>

    <!-- ── 3. The 4 Ecosystem Products ──────────────────────────────────────── -->
    <div class="ecosystem-section" id="products">
      <div class="section-heading">
        <span class="section-label">The Ecosystem</span>
        <h2 class="section-title">Four focused tools. One high standard.</h2>
        <p class="section-subtitle">
          Each product is engineered for a specific job instead of turning one application into a bloated database.
        </p>

        <!-- Apple Segmented Control (Accessible filter tabs) -->
        <div class="segmented-control" role="tablist" aria-label="Product filter" id="productTablist">
          <div class="seg-pill-bg" id="segPillBg" aria-hidden="true"></div>
          <button class="seg-btn active" data-filter="all" role="tab" aria-selected="true" id="tab-prod-all" aria-controls="panel-prod-all">
            <span>All Products</span>
            <span class="seg-count">4</span>
          </button>
          <button class="seg-btn" data-filter="kfit-app" role="tab" aria-selected="false" id="tab-prod-app" aria-controls="card-kfit-app">
            <span class="seg-dot"></span>
            <span>KFit App</span>
          </button>
          <button class="seg-btn" data-filter="kfit-web" role="tab" aria-selected="false" id="tab-prod-web" aria-controls="card-kfit-web">
            <span class="seg-dot"></span>
            <span>KFit Web</span>
          </button>
          <button class="seg-btn" data-filter="gymworld" role="tab" aria-selected="false" id="tab-prod-gymworld" aria-controls="card-gymworld">
            <span class="seg-dot"></span>
            <span>GymWorld</span>
          </button>
          <button class="seg-btn" data-filter="jarvis" role="tab" aria-selected="false" id="tab-prod-jarvis" aria-controls="card-jarvis">
            <span class="seg-dot"></span>
            <span>JARVIS</span>
          </button>
        </div>
      </div>

      <!-- Bento Cards Grid (Solid cards with restrained specular light) -->
      <div class="products-grid" id="productsGrid">

        <!-- ===== PRODUCT 1: KFIT APP ===== -->
        <article class="bento-card" data-category="kfit-app" id="card-kfit-app">
          <div class="bento-card-header">
            <div class="brand-info">
              <div class="product-icon icon-dark">
                <span class="icon-glyph">K</span>
              </div>
              <div>
                <div class="product-category">Native Android &middot; Offline-First</div>
                <h3 class="product-title">KFit for Android</h3>
              </div>
            </div>
            <div class="status-pill">
              <span class="status-dot"></span>
              <span>{kfit.version} &middot; {kfit.sizeFormatted}</span>
            </div>
          </div>

          <p class="bento-desc">
            Local-first fitness tracking for nutrition, workouts, hydration, body composition and progress.
          </p>

          <div class="card-ui-preview">
            <div class="preview-header">
              <span class="win-dot close"></span>
              <span class="win-dot minimize"></span>
              <span class="win-dot zoom"></span>
              <span class="preview-title">kfit &middot; local tracking engine</span>
            </div>
            <div class="preview-body">
              <div class="stat-dual-row">
                <div class="preview-stat-box">
                  <span class="p-stat-lbl">DAILY BUDGET</span>
                  <span class="p-stat-val text-white">1,247 / 1,700 kcal</span>
                </div>
                <div class="preview-stat-box">
                  <span class="p-stat-lbl">PLANNED DEFICIT</span>
                  <span class="p-stat-val text-muted">&minus;453 kcal</span>
                </div>
              </div>
              <div class="macro-triple-row">
                <div class="macro-tile">
                  <span class="tile-val">142g</span>
                  <span class="tile-lbl">Protein</span>
                </div>
                <div class="macro-tile">
                  <span class="tile-val">185g</span>
                  <span class="tile-lbl">Carbs</span>
                </div>
                <div class="macro-tile">
                  <span class="tile-val">44g</span>
                  <span class="tile-lbl">Fats</span>
                </div>
              </div>
            </div>
          </div>

          <div class="spec-matrix">
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Local SQLite storage</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Account optional</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Indian nutrition sources</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{kfit.supportedAndroid} (minSdk {kfit.minSdk})</span>
            </div>
          </div>

          <details class="tech-expandable">
            <summary class="tech-toggle">Technical architecture &rarr;</summary>
            <div class="tech-content">
              Runs fully on-device using SQLite with Room/Drift. Energy expenditure uses MET-based exercise formulas. Optional background sync links to KFit Web via Postgres when signed in. Companion actions link via Android Binder IPC.
            </div>
          </details>

          <div class="card-actions">
            <a href="/downloads/kfit" class="btn btn-primary btn-action" download="kfit.apk">
              <svg class="dl-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
              </svg>
              <span class="btn-text">Download KFit APK</span>
            </a>
            <a href={kfit.releaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sub-action">
              <span>Release Notes</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
          </div>
        </article>

        <!-- ===== PRODUCT 2: KFIT WEB ===== -->
        <article class="bento-card" data-category="kfit-web" id="card-kfit-web">
          <div class="bento-card-header">
            <div class="brand-info">
              <div class="product-icon icon-glass">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </div>
              <div>
                <div class="product-category">Web Platform &middot; Responsive PWA</div>
                <h3 class="product-title">KFit Web</h3>
              </div>
            </div>
            <div class="status-pill">
              <span class="status-dot"></span>
              <span>getkfit.app &middot; Live</span>
            </div>
          </div>

          <p class="bento-desc">
            Your KFit experience across phone, tablet and desktop — installable as a PWA, with optional account sync and offline application access.
          </p>

          <div class="card-ui-preview">
            <div class="preview-header">
              <span class="win-dot close"></span>
              <span class="win-dot minimize"></span>
              <span class="win-dot zoom"></span>
              <span class="preview-title">getkfit.app &middot; web client</span>
            </div>
            <div class="preview-body">
              <div class="preview-search-bar">
                <span>Search food database, log sets, or review trends</span>
              </div>
              <div class="preview-tags-row">
                <span class="preview-tag">Installable PWA</span>
                <span class="preview-tag">IndexedDB Local Cache</span>
                <span class="preview-tag">Offline Capable</span>
              </div>
            </div>
          </div>

          <div class="spec-matrix">
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Modern browsers (Chrome, Edge, Firefox, Safari)</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>PWA installable on all screens</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Optional cross-device account sync</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Offline shell &amp; cached records</span>
            </div>
          </div>

          <details class="tech-expandable">
            <summary class="tech-toggle">Technical architecture &rarr;</summary>
            <div class="tech-content">
              Built with responsive components and service worker caching for offline access. Stores local cache in browser IndexedDB. Uses a robust synchronisation contract with PostgreSQL when connected to a user account.
            </div>
          </details>

          <div class="card-actions">
            <a href={web.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-action">
              <span>Open KFit Web</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
            <a href={web.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sub-action">
              <span>getkfit.app</span>
            </a>
          </div>
        </article>

        <!-- ===== PRODUCT 3: GYMWORLD ===== -->
        <article class="bento-card" data-category="gymworld" id="card-gymworld">
          <div class="bento-card-header">
            <div class="brand-info">
              <div class="product-icon icon-glass">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
              </div>
              <div>
                <div class="product-category">Studio Platform &middot; Gyms &amp; Coaches</div>
                <h3 class="product-title">GymWorld</h3>
              </div>
