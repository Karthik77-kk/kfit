---
import HeroSection from './ecosystem/HeroSection.astro';
import HeroNarrative from './ecosystem/HeroNarrative.astro';
import MealDemo from './ecosystem/MealDemo.astro';
import ProductShowcase from './ecosystem/ProductShowcase.astro';
import ArchitectureSynergy from './ecosystem/ArchitectureSynergy.astro';
import Principles from './ecosystem/Principles.astro';
import SideloadGuide from './ecosystem/SideloadGuide.astro';
import ReleaseVerification from './ecosystem/ReleaseVerification.astro';
import CreatorStory from './ecosystem/CreatorStory.astro';

interface Props {
  isStandalone?: boolean;
}

const { isStandalone = false } = Astro.props;
---

<div class={`ecosystem-root ${isStandalone ? 'standalone-hub' : ''}`} id="ecosystem">
  <!-- Subtle monochromatic ambient lighting -->
  <div class="ambient-glow ambient-glow-top" aria-hidden="true"></div>

  <div class="container">
    <!-- 1. Hero Section -->
    <HeroSection />

    <!-- 2. Hero Product Narrative Composition -->
    <HeroNarrative />

    <!-- 3. Interactive Food Journal Simulator -->
    <MealDemo />

    <!-- 4. Four Product Showcase Bento Cards -->
    <ProductShowcase />

    <!-- 5. Architecture & Product Synergy -->
    <ArchitectureSynergy />

    <!-- 6. Core Product Principles -->
    <Principles />

    <!-- 7. Sideload Installation Guide -->
    <SideloadGuide />

    <!-- 8. Cryptographic Release Verification -->
    <ReleaseVerification />

    <!-- 9. Creator & Craft Philosophy -->
    <CreatorStory />
  </div>
</div>

<script>
  // Global download micro-interaction feedback
  const setupDownloadFeedback = (selector: string) => {
    const buttons = document.querySelectorAll<HTMLAnchorElement>(selector);
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const textSpan = btn.querySelector<HTMLElement>('.btn-text, span');
        if (textSpan) {
          const originalText = textSpan.textContent;
          textSpan.textContent = 'Starting Download…';
          btn.style.opacity = '0.85';
          setTimeout(() => {
            if (textSpan && originalText) textSpan.textContent = originalText;
            btn.style.opacity = '1';
          }, 3000);
        }
      });
    });
  };

  setupDownloadFeedback('[data-kfit-dl]');
  setupDownloadFeedback('[data-jarvis-dl]');
</script>

<style>
  .ecosystem-root {
    position: relative;
    overflow: hidden;
    padding: 60px 0 80px 0;
  }

  .standalone-hub {
    padding-top: 100px;
    min-height: 100vh;
  }

  /* Monochromatic Ambient Glow */
  .ambient-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(140px);
    z-index: 0;
  }

  .ambient-glow-top {
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 450px;
    background: radial-gradient(circle, rgba(0, 113, 227, 0.08) 0%, rgba(255, 255, 255, 0) 70%);
  }

  html[data-theme="dark"] .ambient-glow-top {
    background: radial-gradient(circle, rgba(255, 255, 255, 0.04) 0%, rgba(0, 0, 0, 0) 70%);
  }
</style>
