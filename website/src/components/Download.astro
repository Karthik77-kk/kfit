---
// Public release URLs with dynamic client-side upgrade
const KFIT_APK_URL = 'https://github.com/Karthik77-kk/kfit/releases/latest/download/kfit.apk';
const JARVIS_APK_URL = 'https://github.com/Karthik77-kk/kfit/releases/latest/download/jarvis.apk';
const KFIT_RELEASES_URL = 'https://github.com/Karthik77-kk/kfit/releases';
const KFIT_WEB_URL = 'https://getkfit.app';
const GYMWORLD_URL = 'https://gymworld.getkfit.app';

interface Props {
  isStandalone?: boolean;
}

const { isStandalone = false } = Astro.props;
---

<section class={`download-section ${isStandalone ? 'standalone-hub' : ''}`} id="ecosystem">
  <!-- Subtle monochromatic Apple ambient light -->
  <div class="ambient-glow ambient-glow-top" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow-center" aria-hidden="true"></div>

  <div class="container">
    <!-- ── 1. Amy + Apple Hero Section ────────────────────────────────────────── -->
    <div class="hero-block">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>The KFit Ecosystem &middot; Private Fitness &amp; Nutrition</span>
      </div>

      <h1 class="hero-title">
        Simple and intuitive fitness tracking.<br />
        <span class="gradient-text">Engineered for your body.</span>
      </h1>

      <p class="hero-subtitle">
        Track authentic Indian nutrition like writing in Apple Notes.
        Analyze body composition, calculate real workout burn, and own your health.
        Zero subscriptions. Zero ads. 100% offline.
      </p>

      <div class="hero-actions">
        <a href={KFIT_APK_URL} class="btn btn-primary hero-btn-dl" id="heroDlBtn" download="kfit.apk">
          <svg class="dl-arrow-icon" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
          </svg>
          <span class="btn-text">Download KFit for Android</span>
        </a>
        <a href={KFIT_WEB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost hero-btn-web">
          <span>Launch Web App</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
      </div>

      <div class="hero-trust-bar">
        <span>Free forever</span>
        <span class="trust-sep">&bull;</span>
        <span>No account required</span>
        <span class="trust-sep">&bull;</span>
        <span>100% offline &amp; private</span>
      </div>
    </div>

    <!-- ── 2. Amy Food Journal Interactive Notes Simulator ────────────────────── -->
    <div class="journal-section" id="journal">
      <div class="section-heading">
        <span class="section-label">Intuitive Craft</span>
        <h2 class="section-title">Track like writing in Apple Notes.</h2>
        <p class="section-subtitle">
          No nested menus. No barcode paywalls. Just type what you ate — our verified Indian nutrition database calculates energy, protein, and macros dynamically in real time.
        </p>
      </div>

      <!-- Interactive Apple Notes Tester -->
      <div class="interactive-journal-frame">
        <div class="note-window-header">
          <div class="window-controls">
            <span class="win-dot close"></span>
            <span class="win-dot minimize"></span>
            <span class="win-dot zoom"></span>
            <span class="note-folder-name">Nutrition Journal &middot; Today</span>
          </div>
          <div class="window-status-pill">
            <span>Verified IFCT-2017 Database</span>
          </div>
        </div>

        <div class="sample-meals-bar">
          <span class="sample-label">Try meal presets:</span>
          <div class="sample-pills">
            <button class="meal-sample-btn active" data-meal="dosa">South Indian Breakfast</button>
            <button class="meal-sample-btn" data-meal="lunch">High-Protein Lunch</button>
            <button class="meal-sample-btn" data-meal="workout">Post-Workout Refuel</button>
            <button class="meal-sample-btn" data-meal="snack">Evening Snack</button>
          </div>
        </div>

        <div class="note-card-inner">
          <div class="note-input-container">
            <label for="interactiveNoteInput" class="sr-only">Type what you ate</label>
            <div class="note-input-field">
              <span class="note-prompt-symbol" aria-hidden="true">&gt;</span>
              <input
                type="text"
                id="interactiveNoteInput"
                class="note-live-input"
                value="2 Masala Dosas with coconut chutney, sambar, and 1 tumbler filter coffee"
                placeholder="Type any food... (e.g. 3 rotis, 150g paneer, 2 eggs, 1 scoop whey)"
                autocomplete="off"
                spellcheck="false"
              />
            </div>
            <div class="note-hint">Tip: Type any ingredients or change numbers above to see instant calculations.</div>
          </div>

          <div class="macros-grid">
            <div class="macro-cell">
              <span class="macro-value" id="demoCalories">510</span>
              <span class="macro-unit">kcal</span>
              <span class="macro-label">Energy</span>
            </div>
            <div class="macro-cell">
              <span class="macro-value" id="demoProtein">14.2</span>
              <span class="macro-unit">g</span>
              <span class="macro-label">Protein</span>
            </div>
            <div class="macro-cell">
              <span class="macro-value" id="demoCarbs">74.5</span>
              <span class="macro-unit">g</span>
              <span class="macro-label">Carbs</span>
            </div>
            <div class="macro-cell">
              <span class="macro-value" id="demoFats">16.8</span>
              <span class="macro-unit">g</span>
              <span class="macro-label">Fats</span>
            </div>
          </div>

          <div class="note-footer-meta">
            <div class="meta-left">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span id="demoSourceText">Verified with IFCT-2017 Indian Food Database &middot; 100% Offline</span>
            </div>
            <div class="meta-right">
              <span class="calc-badge">Instant Local Engine</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Amy-style 3 Value Pillars -->
      <div class="amy-pillars">
        <div class="pillar-card">
          <div class="pillar-num">01</div>
          <h3 class="pillar-title">Type what you ate</h3>
          <p class="pillar-text">Just jot down your meal naturally like writing in Apple Notes. No searching through endless crowdsourced junk.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-num">02</div>
          <h3 class="pillar-title">Verified Indian nutrition</h3>
          <p class="pillar-text">700+ authentic Indian recipes backed by the ICMR-NIN IFCT-2017 database with real portion terms (katori, roti, plate).</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-num">03</div>
          <h3 class="pillar-title">100% Offline &amp; private</h3>
          <p class="pillar-text">Runs on your smartphone in local SQLite. Zero subscriptions, zero third-party telemetry, and works in airplane mode.</p>
        </div>
      </div>
    </div>

    <!-- ── 3. The 4 Ecosystem Products: Apple Bento Grid ─────────────────────── -->
    <div class="ecosystem-section" id="products">
      <div class="section-heading">
        <span class="section-label">Complete Ecosystem</span>
        <h2 class="section-title">Simple, but powerful.</h2>
        <p class="section-subtitle">
          Four dedicated tools engineered for athletes, coaches, and everyone who values performance and privacy.
        </p>

        <!-- Apple Segmented Control -->
        <div class="segmented-control" role="tablist" aria-label="Product filter">
          <div class="seg-pill-bg" id="segPillBg" aria-hidden="true"></div>
          <button class="seg-btn active" data-filter="all" role="tab" aria-selected="true">
            <span>All Products</span>
            <span class="seg-count">4</span>
          </button>
          <button class="seg-btn" data-filter="kfit-app" role="tab" aria-selected="false">
            <span class="seg-dot"></span>
            <span>KFit App</span>
          </button>
          <button class="seg-btn" data-filter="kfit-web" role="tab" aria-selected="false">
            <span class="seg-dot"></span>
            <span>KFit Web</span>
          </button>
          <button class="seg-btn" data-filter="gymworld" role="tab" aria-selected="false">
            <span class="seg-dot"></span>
            <span>GymWorld</span>
          </button>
          <button class="seg-btn" data-filter="jarvis" role="tab" aria-selected="false">
            <span class="seg-dot"></span>
            <span>JARVIS</span>
          </button>
        </div>
      </div>

      <!-- Bento Cards Grid -->
      <div class="products-grid" id="productsGrid">

        <!-- ===== PRODUCT 1: KFIT APP ===== -->
        <article class="bento-card" data-category="kfit-app">
          <div class="card-spotlight" aria-hidden="true"></div>

          <div class="bento-card-header">
            <div class="brand-info">
              <div class="product-icon icon-dark">
                <span class="icon-glyph">K</span>
              </div>
              <div>
                <div class="product-category">Native Android &middot; Offline-First</div>
                <h3 class="product-title">KFit App</h3>
              </div>
            </div>
            <div class="status-pill" id="kfitTagPill">
              <span class="status-dot"></span>
              <span id="kfitVersionText">Latest APK</span>
            </div>
          </div>

          <p class="bento-desc">
            Pure fitness tracking engineered for Indian diets.
            700+ verified IFCT dishes, smart body recomp analytics (FFMI &amp; body fat&nbsp;%), MET-based workout burn, and 100% offline SQLite storage. Zero subscriptions. Zero tracking.
          </p>

          <div class="card-ui-preview">
            <div class="preview-header">
              <span class="win-dot close"></span>
              <span class="win-dot minimize"></span>
              <span class="win-dot zoom"></span>
              <span class="preview-title">kfit-app &middot; offline engine</span>
            </div>
            <div class="preview-body">
              <div class="stat-dual-row">
                <div class="preview-stat-box">
                  <span class="p-stat-lbl">DAILY CALORIES</span>
                  <span class="p-stat-val text-white">1,247 / 1,700 kcal</span>
                </div>
                <div class="preview-stat-box">
                  <span class="p-stat-lbl">TARGET DEFICIT</span>
                  <span class="p-stat-val text-muted">-453 kcal</span>
                </div>
              </div>
              <div class="macro-triple-row">
                <div class="macro-tile">
                  <span class="tile-val">142g</span>
                  <span class="tile-lbl">Protein</span>
                </div>
                <div class="macro-tile">
                  <span class="tile-val">185g</span>
                  <span class="tile-lbl">Carbs</span>
                </div>
                <div class="macro-tile">
                  <span class="tile-val">44g</span>
                  <span class="tile-lbl">Fats</span>
                </div>
              </div>
            </div>
          </div>

          <div class="spec-matrix">
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              <span>Android 8.0+</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span id="kfitSizeText">~170 MB APK</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
              <span>Zero Play Store Tracking</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>No Account Needed</span>
            </div>
          </div>

          <div class="card-actions">
            <a href={KFIT_APK_URL} class="btn btn-primary btn-action" id="kfitMainDlBtn" download="kfit.apk">
              <svg class="dl-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
              </svg>
              <span class="btn-text">Download KFit APK</span>
            </a>
            <a href={KFIT_RELEASES_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sub-action">
              <span>All Releases</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
          </div>
        </article>

        <!-- ===== PRODUCT 2: KFIT WEB ===== -->
        <article class="bento-card" data-category="kfit-web">
          <div class="card-spotlight" aria-hidden="true"></div>

          <div class="bento-card-header">
            <div class="brand-info">
              <div class="product-icon icon-glass">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </div>
              <div>
                <div class="product-category">Web Platform &middot; Installable PWA</div>
                <h3 class="product-title">KFit Web</h3>
              </div>
            </div>
            <div class="status-pill">
              <span class="status-dot"></span>
              <span>getkfit.app &middot; Live</span>
            </div>
          </div>

          <p class="bento-desc">
            The expansive desktop experience.
            Engineered for widescreen clarity and rapid keyboard entry (<code class="apple-code">⌘K</code>). Instant food lookup, multi-week deficit trends, and seamless cross-device sync with Android.
          </p>

          <div class="card-ui-preview">
            <div class="preview-header">
              <span class="win-dot close"></span>
              <span class="win-dot minimize"></span>
              <span class="win-dot zoom"></span>
              <span class="preview-title">getkfit.app &middot; live platform</span>
            </div>
            <div class="preview-body">
              <div class="preview-search-bar">
                <span>🔍</span>
                <span>Search 700+ Indian foods or press <kbd>⌘K</kbd></span>
              </div>
              <div class="preview-tags-row">
                <span class="preview-tag">PWA Ready</span>
                <span class="preview-tag">Offline First</span>
                <span class="preview-tag">Zero Install</span>
              </div>
            </div>
          </div>

          <div class="spec-matrix">
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
              <span>Chrome, Safari, Firefox</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
              <span>Cross-Device Cloud Sync</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              <span>Desktop &amp; Tablet Optimized</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Instant Load &middot; No Setup</span>
            </div>
          </div>

          <div class="card-actions">
            <a href={KFIT_WEB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-action">
              <span>Launch KFit Web</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
            <a href={KFIT_WEB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sub-action">
              <span>getkfit.app</span>
            </a>
          </div>
        </article>

        <!-- ===== PRODUCT 3: GYMWORLD ===== -->
        <article class="bento-card" data-category="gymworld">
          <div class="card-spotlight" aria-hidden="true"></div>

          <div class="bento-card-header">
            <div class="brand-info">
              <div class="product-icon icon-glass">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 5v14M18 5v14M2 9v6M22 9v6M6 12h12"/>
                </svg>
              </div>
              <div>
                <div class="product-category">Studio Platform &middot; Gyms &amp; Coaches</div>
                <h3 class="product-title">GymWorld</h3>
              </div>
            </div>
            <div class="status-pill">
              <span class="status-dot"></span>
              <span>gymworld.getkfit.app &middot; Live</span>
            </div>
          </div>

          <p class="bento-desc">
            The operating system for modern gyms and strength coaches.
            Renewal desk, member workflows, active training plans, and immediate customer contact — without messy spreadsheets.
          </p>

          <div class="card-ui-preview">
            <div class="preview-header">
              <span class="win-dot close"></span>
              <span class="win-dot minimize"></span>
              <span class="win-dot zoom"></span>
              <span class="preview-title">gymworld.getkfit.app &middot; portal</span>
            </div>
            <div class="preview-body">
              <div class="stat-dual-row">
                <div class="preview-stat-box">
                  <span class="p-stat-lbl">ACTIVE ATHLETES</span>
                  <span class="p-stat-val text-white">184 members</span>
                </div>
                <div class="preview-stat-box">
                  <span class="p-stat-lbl">RETENTION RATE</span>
                  <span class="p-stat-val text-white">98.2%</span>
                </div>
              </div>
              <div class="preview-activity-note">
                <span>✓ Athlete check-in recorded &middot; Strength Block A</span>
              </div>
            </div>
          </div>

          <div class="spec-matrix">
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span>Gyms, Studios &amp; Trainers</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              <span>Renewal &amp; Member Desk</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>Attendance &amp; Routine Plans</span>
            </div>
            <div class="spec-cell">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Cloudflare Edge &amp; Supabase RLS</span>
            </div>
          </div>

          <div class="card-actions">
            <a href={GYMWORLD_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-action">
              <span>Open GymWorld</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
            <a href={GYMWORLD_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sub-action">
              <span>gymworld.getkfit.app</span>
            </a>
          </div>
        </article>

        <!-- ===== PRODUCT 4: JARVIS ===== -->
        <article class="bento-card" data-category="jarvis">
          <div class="card-spotlight" aria-hidden="true"></div>

          <div class="bento-card-header">
            <div class="brand-info">
              <div class="product-icon icon-glass">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                  <line x1="12" y1="19" x2="12" y2="23"/>
                  <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
              </div>
              <div>
                <div class="product-category">Companion OS &middot; Ambient Voice</div>
                <h3 class="product-title">JARVIS</h3>
              </div>
            </div>
            <div class="status-pill" id="jarvisTagPill">
              <span class="status-dot"></span>
              <span id="jarvisVersionText">Companion APK</span>
            </div>
          </div>

          <p class="bento-desc">
            Ambient voice intelligence linked directly to KFit via Android AIDL (<code class="apple-code">IKFitToolService</code>).
            Record sets, log nutrition, and track hydration between exercises by simply speaking. Zero friction, zero screen taps.
          </p>

          <div class="card-ui-preview">
            <div class="preview-header">
              <span class="win-dot close"></span>
              <span class="win-dot minimize"></span>
              <span class="win-dot zoom"></span>
              <span class="preview-title">jarvis.apk &middot; binder active</span>
            </div>
            <div class="preview-body">
              <div class="preview-voice-stream">
                <div class="audio-bars">
                  <span class="abar a1"></span>
                  <span class="abar a2"></span>
                  <span class="abar a3"></span>
                  <span class="abar a4"></span>
                  <span class="abar a5"></span>
                  <span class="abar a6"></span>
                </div>
                <span class="voice-stream-label">Edge Voice Stream &middot; Zero Latency</span>
              </div>
              <div class="preview-dialogue-box">
