<script>
  import gsap from 'gsap';

  // 1. Hero Narrative Composition Tab Switching
  const narrativeTabs = document.querySelectorAll('.n-tab');
  const narrativePanes = document.querySelectorAll('.narrative-pane');

  narrativeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const step = tab.getAttribute('data-step');
      if (!step) return;

      narrativeTabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      narrativePanes.forEach((p) => {
        p.classList.remove('active');
        p.setAttribute('hidden', 'true');
      });

      const activePane = document.getElementById(`pane-${step}`);
      if (activePane) {
        activePane.removeAttribute('hidden');
        activePane.classList.add('active');
        gsap.fromTo(activePane, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.25, ease: 'power2.out' });
      }
    });
  });

  // 2. Canonical Meal Fixtures Data (from real KFit test fixtures)
  const canonicalFixtures: Record<string, {
    text: string;
    cal: number;
    pro: number;
    carb: number;
    fat: number;
    source: string;
    hint: string;
  }> = {
    dosa: {
      text: '2 Masala Dosas with coconut chutney, sambar, and 1 tumbler filter coffee',
      cal: 510,
      pro: 14.2,
      carb: 74.5,
      fat: 16.8,
      source: 'Source: Curated KFit foods · IFCT 2017 portion reference',
      hint: 'Viewing canonical test fixture · Values verified against KFit test suite.',
    },
    lunch: {
      text: '200g Paneer tikka, 2 whole wheat rotis, 1 cup dal tadka',
      cal: 790,
      pro: 44.3,
      carb: 58.2,
      fat: 41.5,
      source: 'Source: Curated KFit foods · High protein bio-availability score: 94%',
      hint: 'Viewing canonical test fixture · Values verified against KFit test suite.',
    },
    recovery: {
      text: '100 g milk, 2 boiled eggs, and 1 medium banana',
      cal: 334,
      pro: 17.2,
      carb: 32.1,
      fat: 15.6,
      source: 'Source: IFCT 2017 lab-measured milk · Curated whole foods',
      hint: 'Viewing canonical test fixture · Values verified against KFit test suite.',
    },
    workout: {
      text: '1 scoop whey protein isolate, 1 robusta banana, 8 almonds',
      cal: 281,
      pro: 28.4,
      carb: 31.8,
      fat: 6.1,
      source: 'Source: Curated KFit foods & IFCT 2017 · Recovery macro profile',
      hint: 'Viewing canonical test fixture · Values verified against KFit test suite.',
    },
  };

  const noteInput = document.getElementById('interactiveNoteInput') as HTMLInputElement | null;
  const demoCal = document.getElementById('demoCalories');
  const demoPro = document.getElementById('demoProtein');
  const demoCarb = document.getElementById('demoCarbs');
  const demoFat = document.getElementById('demoFats');
  const demoSource = document.getElementById('demoSourceText');
  const demoHint = document.getElementById('demoHintText');
  const fixtureBtns = document.querySelectorAll('.meal-sample-btn');

  let currentNutrients = { cal: 510, pro: 14.2, carb: 74.5, fat: 16.8 };

  function animateNutrientValues(cal: number, pro: number, carb: number, fat: number) {
    gsap.killTweensOf(currentNutrients);
    gsap.to(currentNutrients, {
      cal,
      pro,
      carb,
      fat,
      duration: 0.3,
      ease: 'power2.out',
      onUpdate: () => {
        if (demoCal) demoCal.textContent = Math.round(currentNutrients.cal).toString();
        if (demoPro) demoPro.textContent = currentNutrients.pro.toFixed(1);
        if (demoCarb) demoCarb.textContent = currentNutrients.carb.toFixed(1);
        if (demoFat) demoFat.textContent = currentNutrients.fat.toFixed(1);
      },
    });
  }

  fixtureBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      fixtureBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const fixtureKey = btn.getAttribute('data-fixture');
      if (fixtureKey && canonicalFixtures[fixtureKey] && noteInput) {
        const data = canonicalFixtures[fixtureKey];
        noteInput.value = data.text;
        animateNutrientValues(data.cal, data.pro, data.carb, data.fat);
        if (demoSource) demoSource.textContent = data.source;
        if (demoHint) demoHint.textContent = data.hint;
      }
    });
  });

  // Honest handling for custom typing: NO fake word-count calculations!
  if (noteInput) {
    noteInput.addEventListener('input', () => {
      fixtureBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      const val = noteInput.value.trim().toLowerCase();
      
      // Match against canonical fixtures if typed
      let matched = false;
      for (const [key, fixture] of Object.entries(canonicalFixtures)) {
        if (fixture.text.toLowerCase().includes(val) || val.includes(key)) {
          matched = true;
          animateNutrientValues(fixture.cal, fixture.pro, fixture.carb, fixture.fat);
          if (demoSource) demoSource.textContent = fixture.source;
          if (demoHint) demoHint.textContent = 'Matched canonical fixture subset.';
          break;
        }
      }

      if (!matched) {
        if (demoSource) {
          demoSource.textContent = 'App pipeline: Learned → Curated (848) → IFCT (528) → OFF/USDA fallback';
        }
        if (demoHint) {
          demoHint.textContent = 'Custom phrase: In the app, this sentence resolves deterministically without guessing.';
        }
      }
    });
  }

  // 3. Product Segmented Filter (Keyboard accessible tabs)
  const segBtns = document.querySelectorAll('.seg-btn');
  const cards = document.querySelectorAll('.bento-card');
  const segPillBg = document.getElementById('segPillBg');

  const updatePill = (btn: HTMLElement) => {
    if (!segPillBg) return;
    const parentRect = btn.parentElement?.getBoundingClientRect();
    const btnRect = btn.getBoundingClientRect();
    if (parentRect) {
      segPillBg.style.left = `${btnRect.left - parentRect.left}px`;
      segPillBg.style.width = `${btnRect.width}px`;
    }
  };

  const initialActive = document.querySelector('.seg-btn.active') as HTMLElement | null;
  if (initialActive) updatePill(initialActive);

  window.addEventListener('load', () => {
    const active = document.querySelector('.seg-btn.active') as HTMLElement | null;
    if (active) updatePill(active);
  });

  segBtns.forEach((btn, index) => {
    btn.addEventListener('click', () => {
      segBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      updatePill(btn as HTMLElement);

      const filter = btn.getAttribute('data-filter');
      cards.forEach((card) => {
        const c = card as HTMLElement;
        const category = c.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          c.style.display = 'flex';
          gsap.to(c, { opacity: 1, scale: 1, duration: 0.25, ease: 'power2.out' });
        } else {
          gsap.to(c, {
            opacity: 0,
            scale: 0.98,
            duration: 0.2,
            ease: 'power2.in',
            onComplete: () => {
              c.style.display = 'none';
            },
          });
        }
      });
    });

    // Keyboard arrow navigation
    btn.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      let nextIndex = index;
      if (keyEvent.key === 'ArrowRight' || keyEvent.key === 'ArrowDown') {
        nextIndex = (index + 1) % segBtns.length;
      } else if (keyEvent.key === 'ArrowLeft' || keyEvent.key === 'ArrowUp') {
        nextIndex = (index - 1 + segBtns.length) % segBtns.length;
      } else if (keyEvent.key === 'Home') {
        nextIndex = 0;
      } else if (keyEvent.key === 'End') {
        nextIndex = segBtns.length - 1;
      } else {
        return;
      }
      keyEvent.preventDefault();
      const nextBtn = segBtns[nextIndex] as HTMLButtonElement;
      nextBtn.focus();
      nextBtn.click();
    });
  });

  window.addEventListener('resize', () => {
    const active = document.querySelector('.seg-btn.active') as HTMLElement | null;
    if (active) updatePill(active);
  });

  // 4. SHA-256 Copy Functionality
  const copyBtns = document.querySelectorAll('.copy-hash-btn');
  copyBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const hash = btn.getAttribute('data-hash');
      if (!hash) return;
      try {
        await navigator.clipboard.writeText(hash);
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('copied');
        }, 2200);
      } catch (err) {
        // Fallback
      }
    });
  });
</script>

