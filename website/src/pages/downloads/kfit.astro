---
import Layout from '../../layouts/Layout.astro';
import releases from '../../data/releases.json';

const release = releases.kfit;
---

<Layout
  title={`${release.name} (${release.version}) — Official Release`}
  description={`Direct signed APK download for ${release.name} (${release.version}, ${release.sizeFormatted}). SHA-256 verified.`}
  noindex={true}
  enableStructuredData={false}
>
  <main class="dl-verify-page">
    <div class="dl-verify-card">
      <div class="dl-icon-wrap">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
        </svg>
      </div>

      <div class="badge-status">Official Signed Release</div>
      <h1>Download {release.name}</h1>
      <p class="dl-sub">Cryptographically verified release. Built and signed for Android.</p>

      <div class="dl-action-box">
        <a href={release.apkUrl} class="btn btn-primary btn-lg" id="manualDlLink">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 16l-5-5 1.4-1.4 2.6 2.6V4h2v8.2l2.6-2.6L17 11l-5 5zm-7 4v-2h14v2H5z"/>
          </svg>
          <span>Download kfit.apk ({release.sizeFormatted})</span>
        </a>
      </div>

      <div class="dl-verify-panel">
        <div class="verify-row">
          <span class="v-label">Release Tag</span>
          <span class="v-val font-mono">{release.version}</span>
        </div>
        <div class="verify-row">
          <span class="v-label">File Size</span>
          <span class="v-val">{release.sizeFormatted} ({release.sizeBytes.toLocaleString()} bytes)</span>
        </div>
        <div class="verify-row">
          <span class="v-label">Supported Android</span>
          <span class="v-val">{release.supportedAndroid} (minSdk {release.minSdk})</span>
        </div>
        <div class="verify-row">
          <span class="v-label">Published</span>
          <span class="v-val font-mono">{release.publishedAt}</span>
        </div>
        <div class="verify-row col">
          <span class="v-label">SHA-256 Checksum</span>
          <code class="v-hash font-mono">{release.sha256}</code>
        </div>
      </div>

      <div class="dl-nav-links">
        <a href="/#sideload" class="text-link">How to install on Android &rarr;</a>
        <span class="dot-sep">&bull;</span>
        <a href="/" class="text-link">Back to Homepage</a>
        <span class="dot-sep">&bull;</span>
        <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer" class="text-link">Release Notes</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .dl-verify-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: var(--bg);
  }
  .dl-verify-card {
    max-width: 580px;
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 44px 36px;
    text-align: center;
    box-shadow: var(--card-shadow);
  }
  .dl-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: var(--icon-bg);
    color: var(--icon-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .badge-status {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #30D158;
    background: rgba(48, 209, 88, 0.1);
    border: 1px solid rgba(48, 209, 88, 0.25);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    margin-bottom: 16px;
  }
  h1 {
    font-size: 26px;
    font-weight: 800;
    color: var(--text-heading);
    margin-bottom: 10px;
    letter-spacing: -0.025em;
  }
  .dl-sub {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 28px;
  }
  .dl-action-box {
    margin-bottom: 32px;
  }
  .btn-lg {
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-full);
  }
  .dl-verify-panel {
    background: var(--card-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }
  .verify-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }
  .verify-row.col {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .v-label {
    color: var(--muted);
    font-weight: 500;
  }
  .v-val {
    color: var(--text-heading);
    font-weight: 600;
  }
  .v-hash {
    display: block;
    width: 100%;
    font-size: 11px;
    line-height: 1.4;
    word-break: break-all;
    background: var(--preview-frame-bg);
    border: 1px solid var(--border);
    padding: 8px 12px;
    border-radius: var(--radius-xs);
    color: var(--text-heading);
  }
  .dl-nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 13px;
    flex-wrap: wrap;
  }
  .text-link {
    color: var(--apple-blue);
    text-decoration: none;
    font-weight: 500;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  .dot-sep {
    color: var(--border-hi);
  }
</style>
