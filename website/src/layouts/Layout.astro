---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KFit — Fitness tracking that stays out of your way',
  description = 'Log Indian meals in plain language. Track workouts, body composition, hydration and trends locally on your device. Works offline, account optional, zero subscriptions.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImageURL = new URL('/og-image.png', canonicalURL);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" id="themeColorMeta" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KFit" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="color-scheme" content="dark light" />

    <!-- Schema.org SoftwareApplication JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "KFit",
        "operatingSystem": "Android, Web",
        "applicationCategory": "HealthAndFitnessApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Fitness tracking that stays out of your way. Engineered for authentic Indian nutrition and private performance.",
        "author": {
          "@type": "Person",
          "name": "Karthik M"
        }
      }
    </script>

    <!-- Inline Apple Theme Pre-paint Init (Zero FOUT) -->
    <script is:inline>
      (function() {
        try {
          const saved = localStorage.getItem('kfit-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          const meta = document.getElementById('themeColorMeta');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#000000' : '#F5F5F7');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <!-- Apple sleek scroll progress bar -->
    <div id="scrollBar" style="position:fixed;top:0;left:0;height:2px;width:0%;background:var(--text-heading,#1D1D1F);z-index:9999;transition:width 0.08s linear;pointer-events:none;"></div>

    <slot />

    <script>
      const bar = document.getElementById('scrollBar');
      window.addEventListener('scroll', () => {
        if (!bar) return;
        const total = document.body.scrollHeight - window.innerHeight;
        const pct = total > 0 ? (window.scrollY / total) * 100 : 0;
        bar.style.width = `${Math.min(pct, 100)}%`;
      }, { passive: true });
    </script>
  </body>
</html>
